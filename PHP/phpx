#!/bin/bash

VERSION="2.0.0-dev"

################################################################################
# Color Constants
################################################################################
# Colors (TTY only)
if [[ -t 1 ]]; then
  RED=$'\033[0;31m'
  GREEN=$'\033[0;32m'
  YELLOW=$'\033[1;33m'
  CYAN=$'\033[0;36m'
  MAG=$'\033[0;35m'
  NC=$'\033[0m'
else
  RED='' GREEN='' YELLOW='' CYAN='' MAG='' NC=''
fi

LOG_FILE=""

################################################################################
# Logging Setup
################################################################################
setup_logging() {
  if [[ -n "${PHPX_NO_LOG:-}" ]]; then
    LOG_FILE=""
    return 0
  fi

  local log_dir="${PHPX_LOG_DIR:-}"
  if [[ -z "$log_dir" ]]; then
    if [[ "$EUID" -eq 0 ]]; then
      log_dir="/var/log/phpx"
    else
      log_dir="${XDG_STATE_HOME:-${HOME:-/tmp}/.local/state}/phpx"
    fi
  fi

  if ! mkdir -p -- "$log_dir" 2>/dev/null; then
    LOG_FILE=""
    return 0
  fi

  LOG_FILE="$log_dir/$(date +'%Y-%m-%d').log"
  if ! touch -- "$LOG_FILE" 2>/dev/null; then
    LOG_FILE=""
  fi
}


################################################################################
# Logging Helper
################################################################################
log_action() {
  # Purpose: Write a log entry to $LOG_FILE with a given level and message.
  # Usage:   log_action "ERROR" "Something went wrong"

  # If logging is disabled, bail out
  if [[ -n "${PHPX_NO_LOG:-}" ]]; then
    return
  fi

  local level="$1"
  local message="$2"
  local current_time
  current_time=$(date +'%Y-%m-%d %H:%M:%S')

  # Logging is deliberately best-effort. Operational output must not be polluted
  # and read-only commands must never fail because a log directory is unavailable.
  [[ -n "$LOG_FILE" ]] || return 0
  printf '%s - [%s] - %s
' "$current_time" "$level" "$message" >>"$LOG_FILE" 2>/dev/null || true
}

################################################################################
# Require sudo
################################################################################
require_sudo() {
  # Ensures the script is run with root privileges (either as root or via sudo).
  # If not, we exit with code 1 and log the error.
  if [[ "$EUID" -ne 0 ]]; then
    echo -e "${RED}Please run this script with sudo or as root.${NC}"
    log_action "ERROR" "Script not run with sudo (EUID=$EUID)."
    exit 1
  fi
}

################################################################################
# Platform / package / service capabilities
################################################################################
require_root_for() {
  local operation="${1:-this operation}"
  if [[ "$EUID" -ne 0 ]]; then
    echo -e "${RED}${operation} requires root privileges.${NC}" >&2
    log_action "ERROR" "$operation requires root privileges (EUID=$EUID)."
    return 1
  fi
}

detect_package_manager() {
  if command -v apt-get >/dev/null 2>&1 && command -v dpkg-query >/dev/null 2>&1; then
    printf 'apt'
  elif command -v dnf >/dev/null 2>&1 && command -v rpm >/dev/null 2>&1; then
    printf 'dnf'
  elif command -v rpm >/dev/null 2>&1; then
    printf 'rpm'
  else
    printf 'none'
  fi
}

package_backend_require_mutation() {
  local backend
  backend="$(detect_package_manager)"
  case "$backend" in
  apt | dnf) printf '%s' "$backend" ;;
  *)
    echo -e "${RED}No supported package-mutation backend is available (detected: $backend).${NC}" >&2
    return 1
    ;;
  esac
}

package_installed() {
  local package="$1"
  case "$(detect_package_manager)" in
  apt) dpkg-query -W -f='${Status}' -- "$package" 2>/dev/null | grep -q '^install ok installed$' ;;
  dnf | rpm) rpm -q --quiet -- "$package" ;;
  *) return 1 ;;
  esac
}

package_install() {
  local backend
  backend="$(package_backend_require_mutation)" || return 1
  case "$backend" in
  apt)
    apt_update_once
    DEBIAN_FRONTEND=noninteractive apt-get install -y -- "$@"
    ;;
  dnf) dnf install -y -- "$@" ;;
  esac
}

package_remove() {
  local backend
  backend="$(package_backend_require_mutation)" || return 1
  case "$backend" in
  apt) DEBIAN_FRONTEND=noninteractive apt-get purge -y -- "$@" ;;
  dnf) dnf remove -y -- "$@" ;;
  esac
}

package_autoremove() {
  case "$(detect_package_manager)" in
  apt) DEBIAN_FRONTEND=noninteractive apt-get autoremove -y ;;
  dnf) dnf autoremove -y ;;
  *) return 0 ;;
  esac
}

detect_service_manager() {
  if command -v systemctl >/dev/null 2>&1 && [[ -d /run/systemd/system ]]; then
    printf 'systemd'
  elif command -v service >/dev/null 2>&1; then
    printf 'service'
  else
    printf 'none'
  fi
}

service_exists() {
  local service_name="$1"
  case "$(detect_service_manager)" in
  systemd) systemctl list-unit-files --type=service --no-legend 2>/dev/null | awk '{print $1}' | grep -Fxq "${service_name}.service" ;;
  service) [[ -x "/etc/init.d/$service_name" ]] ;;
  *) return 1 ;;
  esac
}

service_is_active() {
  local service_name="$1"
  case "$(detect_service_manager)" in
  systemd) systemctl is-active --quiet "$service_name" 2>/dev/null ;;
  service) service "$service_name" status >/dev/null 2>&1 ;;
  *) return 1 ;;
  esac
}

service_action() {
  local action="$1" service_name="$2"
  case "$(detect_service_manager)" in
  systemd) systemctl "$action" "$service_name" ;;
  service)
    case "$action" in
    start | stop | restart | reload | status) service "$service_name" "$action" ;;
    *) echo -e "${RED}Service action '$action' requires systemd.${NC}" >&2; return 1 ;;
    esac
    ;;
  *) echo -e "${RED}No supported service manager is available.${NC}" >&2; return 1 ;;
  esac
}

service_enable_action() {
  local action="$1" service_name="$2"
  [[ "$(detect_service_manager)" == "systemd" ]] || {
    echo -e "${RED}Service '$action' requires systemd.${NC}" >&2
    return 1
  }
  systemctl "$action" "$service_name"
}

find_php_binary() {
  local version="${1:-}" candidate
  if [[ -n "$version" ]]; then
    for candidate in "/usr/bin/php$version" "/usr/local/bin/php$version"; do
      [[ -x "$candidate" ]] && { printf '%s' "$candidate"; return 0; }
    done
    return 1
  fi
  command -v php 2>/dev/null
}

atomic_write_file() {
  local target="$1" mode="${2:-0644}"
  local dir tmp
  dir="$(dirname -- "$target")"
  mkdir -p -- "$dir" || return 1
  tmp="$(mktemp "${dir}/.phpx.tmp.XXXXXX")" || return 1
  if ! cat >"$tmp"; then
    rm -f -- "$tmp"
    return 1
  fi
  chmod "$mode" "$tmp" || { rm -f -- "$tmp"; return 1; }
  mv -f -- "$tmp" "$target"
}

bounded_curl() {
  curl --fail --location --silent --show-error --retry 3 \
    --connect-timeout 10 --max-time 120 "$@"
}

verify_sha384() {
  local file="$1" expected="$2" actual
  [[ "$expected" =~ ^[A-Fa-f0-9]{96}$ ]] || return 1
  if command -v sha384sum >/dev/null 2>&1; then
    actual="$(sha384sum -- "$file" | awk '{print $1}')"
  elif command -v openssl >/dev/null 2>&1; then
    actual="$(openssl dgst -sha384 "$file" | awk '{print $NF}')"
  elif command -v php >/dev/null 2>&1; then
    actual="$(php -r 'echo hash_file("sha384", $argv[1]);' "$file")"
  else
    return 1
  fi
  [[ "${actual,,}" == "${expected,,}" ]]
}

validate_extension_name() {
  [[ "${1:-}" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]]
}

validate_github_extension_spec() {
  [[ "${1:-}" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(@[A-Za-z0-9._/-]+)?$ ]]
}

################################################################################
# PHP Version Validation
################################################################################
validate_php_version() {
  # Purpose: Ensure the given string is in the format "X.Y"
  # Example valid versions: 7.4, 8.0, 8.2, etc.

  local version="$1"

  # 1. Check if a version was provided
  if [[ -z "$version" ]]; then
    echo -e "${RED}Error: No PHP version was provided to validate.${NC}"
    log_action "ERROR" "No PHP version was provided to validate."
    exit 2
  fi

  # 2. Check that it matches the pattern digits.digits
  if ! [[ "$version" =~ ^[0-9]+\.[0-9]+$ ]]; then
    echo -e "${RED}Invalid PHP version format. Expected format: X.Y (e.g., 8.2).${NC}"
    log_action "ERROR" "Invalid PHP version format: $version"
    exit 2
  fi

  # 3. If we get here, it's valid
  log_action "INFO" "Validated PHP version format: $version"
}

################################################################################
# Show Last Lines (Fancy Tail)
################################################################################
show_last_lines() {
  # Purpose: Continuously read from stdin, buffer the last N lines, and print only those lines
  #          (overwriting in place) if stdout is a terminal. Otherwise, just print lines normally.
  #
  # Usage Example:
  #   some_long_command | show_last_lines
  #
  # By default, max_lines=5.

  local line_buffer=()
  local max_lines=5 # Number of lines to display
  local is_terminal=false

  # Check if stdout is attached to a terminal
  if [[ -t 1 ]]; then
    is_terminal=true
  fi

  while IFS= read -r line; do
    # Add the new line to our ring buffer
    line_buffer+=("$line")

    # Keep only the last $max_lines lines
    if [[ ${#line_buffer[@]} -gt $max_lines ]]; then
      line_buffer=("${line_buffer[@]:1}")
    fi

    # If stdout is a terminal, overwrite existing lines
    if [[ "$is_terminal" == true ]]; then
      # Clear the current line
      printf "\033[2K\r"
      # Print the buffered lines
      for buffered_line in "${line_buffer[@]}"; do
        echo -e "$buffered_line"
      done
      # Move the cursor back up to overwrite the previous lines
      printf "\033[%sA" "${#line_buffer[@]}"
    else
      # If not a terminal (e.g., piped to file), just print each line as it arrives
      echo -e "$line"
    fi
  done

  # After the loop finishes, if it was a terminal, move the cursor down
  if [[ "$is_terminal" == true ]]; then
    printf "\033[%sB" "$max_lines"
  fi
}

################################################################################
# Apt Update Once Helper
################################################################################
apt_update_once() {
  [[ "$(detect_package_manager)" == "apt" ]] || {
    echo -e "${RED}APT backend is not available on this system.${NC}" >&2
    return 1
  }
  if [[ -z "${_PHPX_APT_UPDATED:-}" ]]; then
    apt-get update 2>&1 | show_last_lines
    _PHPX_APT_UPDATED=1
  fi
}

################################################################################
# Add Sury Repo if Needed (Ubuntu/Debian)
################################################################################
add_sury_repo_if_needed() {
  require_root_for "phpx sury" || return 1
  [[ "$(detect_package_manager)" == "apt" ]] || {
    echo -e "${RED}phpx sury is supported only by the APT backend.${NC}" >&2
    return 3
  }
  [[ -r /etc/os-release ]] || { echo -e "${RED}Cannot read /etc/os-release.${NC}" >&2; return 1; }

  # /etc/os-release is a root-owned system contract, not user configuration.
  # shellcheck disable=SC1091
  . /etc/os-release
  local detected_os="${ID,,}" detected_like="${ID_LIKE:-}" codename
  detected_like="${detected_like,,}"
  codename="${VERSION_CODENAME:-${UBUNTU_CODENAME:-}}"
  [[ "$codename" =~ ^[a-z0-9][a-z0-9.-]*$ ]] || {
    echo -e "${RED}Unable to determine a safe distribution codename.${NC}" >&2
    return 1
  }

  package_install ca-certificates curl >/dev/null || return 1

  if [[ "$detected_os" == ubuntu || "$detected_like" == *ubuntu* ]]; then
    command -v add-apt-repository >/dev/null 2>&1 || package_install software-properties-common >/dev/null || return 1
    if ! grep -RqsE '^[[:space:]]*deb .*ondrej/php' /etc/apt/sources.list /etc/apt/sources.list.d 2>/dev/null; then
      echo -e "${YELLOW}Adding Ondřej PHP PPA for ${codename}.${NC}"
      timeout 120 add-apt-repository -y ppa:ondrej/php 2>&1 | show_last_lines || return 1
      unset _PHPX_APT_UPDATED
      apt_update_once || return 1
    fi
  elif [[ "$detected_os" == debian || "$detected_like" == *debian* ]]; then
    bounded_curl --head "https://packages.sury.org/php/dists/${codename}/Release" >/dev/null || {
      echo -e "${RED}Sury does not publish PHP metadata for '${codename}'.${NC}" >&2
      return 4
    }

    if ! grep -RqsE '^[[:space:]]*deb .*packages\.sury\.org/php' /etc/apt/sources.list /etc/apt/sources.list.d 2>/dev/null; then
      local tmp_dir keyring_pkg source_line
      tmp_dir="$(mktemp -d)" || return 1
      trap 'rm -rf -- "$tmp_dir"' RETURN
      keyring_pkg="$tmp_dir/debsuryorg-archive-keyring.deb"
      bounded_curl 'https://packages.sury.org/debsuryorg-archive-keyring.deb' --output "$keyring_pkg" || return 1
      [[ "$(dpkg-deb -f "$keyring_pkg" Package 2>/dev/null || true)" == debsuryorg-archive-keyring ]] || {
        echo -e "${RED}Downloaded Sury keyring package identity check failed.${NC}" >&2
        return 1
      }
      dpkg -i -- "$keyring_pkg" 2>&1 | show_last_lines || return 1
      source_line="deb [signed-by=/usr/share/keyrings/deb.sury.org-php.gpg] https://packages.sury.org/php/ ${codename} main"
      printf '%s
' "$source_line" | atomic_write_file /etc/apt/sources.list.d/php.list 0644 || return 1
      unset _PHPX_APT_UPDATED
      apt_update_once || return 1
    fi
  else
    echo -e "${RED}Unsupported distribution for phpx sury: ${detected_os}.${NC}" >&2
    return 3
  fi

  log_action INFO "PHP package repository is configured for ${detected_os} (${codename})."
}

################################################################################
# Get PHP Version
################################################################################
get_php_version() {
  # Purpose:
  #   1. If a version (X.Y) is provided, validate it and check if it's installed.
  #   2. If no version is provided, try detecting the active PHP version from `php -r`.
  #   3. Return the valid version or exit with an error.

  local version="$1"

  # If no version is provided, attempt to detect the currently active PHP version
  if [[ -z "$version" ]]; then
    version="$(php -r 'echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;' 2>/dev/null)"
    if [[ -z "$version" ]]; then
      echo -e "${RED}No PHP version provided and no active PHP version detected.${NC}"
      log_action "ERROR" "No PHP version provided and no active PHP version detected."
      exit 1
    fi
    echo -e "${YELLOW}No PHP version provided. Using detected PHP version: $version${NC}"
    log_action "INFO" "Detected PHP version: $version."
  fi

  # Validate the format (X.Y)
  validate_php_version "$version"

  # Check if the binary for that version exists in either /usr/bin or /usr/local/bin
  local binary_candidate=""
  if command -v "/usr/bin/php$version" &>/dev/null; then
    binary_candidate="/usr/bin/php$version"
  elif command -v "/usr/local/bin/php$version" &>/dev/null; then
    binary_candidate="/usr/local/bin/php$version"
  fi

  if [[ -z "$binary_candidate" ]]; then
    echo -e "${RED}PHP version $version is not installed (checked /usr/bin and /usr/local/bin).${NC}"
    log_action "ERROR" "PHP version $version not found."
    exit 1
  fi

  # Return the confirmed PHP version
  echo "$version"
}

################################################################################
# Clean PHP Extensions (Remove Missing .so refs)
################################################################################
check_and_clean_php_extensions() {
  require_sudo
  local version="$1"

  # If user didn't provide a version, auto-detect via get_php_version
  if [[ -z "$version" ]]; then
    version="$(get_php_version)"
  else
    version="$(get_php_version "$version")"
  fi

  local php_binary=""
  if command -v "/usr/bin/php$version" &>/dev/null; then
    php_binary="/usr/bin/php$version"
  elif command -v "/usr/local/bin/php$version" &>/dev/null; then
    php_binary="/usr/local/bin/php$version"
  else
    echo -e "${RED}PHP version $version is not installed or not found.${NC}"
    log_action "WARN" "PHP version $version not found for extension cleanup."
    return 1
  fi

  local missing_extensions=()
  IFS=$'\n' read -r -d '' -a missing_extensions < <(
    "$php_binary" -m 2>&1 |
      grep "Unable to load dynamic library" |
      awk -F"'" '{print $2}' &&
      printf '\0'
  )

  if [[ ${#missing_extensions[@]} -eq 0 ]]; then
    echo -e "${GREEN}No missing extensions detected for PHP $version.${NC}"
    log_action "INFO" "No missing extensions for PHP $version."
    return 0
  fi

  echo -e "${YELLOW}Cleaning up configuration for the following missing extensions: ${missing_extensions[*]}${NC}"
  log_action "INFO" "Cleaning up missing extensions: ${missing_extensions[*]} for PHP $version."

  for ext in "${missing_extensions[@]}"; do
    local ext_base
    ext_base="$(basename "$ext" .so)"

    find "/etc/php/$version" -type f -name "*${ext_base}*.ini" -exec rm -v {} \; 2>/dev/null |
      while read -r removed_file; do
        echo -e "${GREEN}Removed $removed_file${NC}"
        log_action "INFO" "Removed broken extension ini: $removed_file"
      done
  done

  echo -e "${GREEN}Cleaned up missing extensions for PHP $version.${NC}"
  log_action "INFO" "Cleaned up missing extensions for PHP $version."
}

################################################################################
# Install PHP Version
################################################################################
install_php_version() {
  require_root_for "install PHP" || return 1
  local version="$1"
  validate_php_version "$version"
  [[ "$(detect_package_manager)" == apt ]] || {
    echo -e "${RED}Versioned PHP installation is currently implemented only for the APT backend.${NC}" >&2
    return 3
  }

  local packages_to_install=() package
  for package in "php$version" "php$version-cli" "php$version-fpm"; do
    package_installed "$package" || packages_to_install+=("$package")
  done
  ((${#packages_to_install[@]})) || {
    echo -e "${GREEN}All core packages for PHP $version are already installed.${NC}"
    return 0
  }

  echo -e "${YELLOW}Installing PHP $version packages: ${packages_to_install[*]}${NC}"
  package_install "${packages_to_install[@]}" 2>&1 | show_last_lines || return 1
  log_action INFO "Installed PHP $version packages: ${packages_to_install[*]}."
}

################################################################################
# Configure Web Server
################################################################################
configure_web_server() {
  local version="$1"

  # 1. Ensure the requested PHP version is installed
  if ! package_installed "php$version"; then
    echo -e "${YELLOW}PHP $version not found. Attempting to install...${NC}"
    log_action "INFO" "PHP $version not found; attempting installation."
    install_php_version "$version" || {
      echo -e "${RED}Failed to install PHP $version. Cannot configure a web server.${NC}"
      log_action "ERROR" "Failed to install PHP $version in configure_web_server."
      return 1
    }
  fi

  # ──────────────────────────────────────────────────────────────────────────────
  # Detect which servers are installed & running
  declare -A server_names=(["apache2"]="Apache" ["nginx"]="Nginx" ["lighttpd"]="Lighttpd")
  local installed_servers=() active_servers=() service

  for service in "${!server_names[@]}"; do
    if dpkg -l | grep -q "^ii  $service "; then
      installed_servers+=("$service")
      systemctl is-active --quiet "$service" && active_servers+=("$service")
    fi
  done

  if [[ ${#installed_servers[@]} -eq 0 ]]; then
    echo -e "${YELLOW}No supported web servers (Apache, Nginx, Lighttpd) installed.${NC}"
    log_action "WARN" "No supported web servers installed."
    return 0
  fi
  installed_servers+=("exit")

  echo -e "${YELLOW}Detected installed web servers:${NC}"
  for i in "${!installed_servers[@]}"; do
    if [[ "${installed_servers[$i]}" == "exit" ]]; then
      echo "$((i + 1)). Exit without configuring"
    else
      printf "%d. %s\n" "$((i + 1))" "${server_names[${installed_servers[$i]}]}"
      if [[ " ${active_servers[*]} " =~ " ${installed_servers[$i]} " ]]; then
        echo "   (Currently running)"
      else
        echo "   (Installed but not running)"
      fi
    fi
  done

  # Prompt selection
  read -rp "Select a web server to configure with PHP $version (enter number): " sel
  while ! [[ "$sel" =~ ^[0-9]+$ && "$sel" -ge 1 && "$sel" -le ${#installed_servers[@]} ]]; do
    echo -e "${RED}Invalid selection. Enter a number between 1 and ${#installed_servers[@]}.${NC}"
    read -rp "Select a web server to configure with PHP $version (enter number): " sel
  done
  local selected_server="${installed_servers[$((sel - 1))]}"

  if [[ "$selected_server" == "exit" ]]; then
    echo -e "${YELLOW}Exiting without configuring any server.${NC}"
    log_action "INFO" "User chose to exit."
    return 0
  fi

  case "$selected_server" in
  apache2)
    local apache_needs_restart=false

    # ─────────── Helpers ───────────
    disable_other_mod_php() {
      local current="php$version"
      local mods
      mods=$(apache2ctl -M 2>/dev/null |
        grep -Eo 'php[0-9]+\.[0-9]+_module' |
        sed 's/_module//')
      for mod in $mods; do
        if [[ "$mod" != "$current" ]]; then
          a2dismod "$mod" 2>/dev/null || true
          apache_needs_restart=true
        fi
      done
    }

    disable_other_php_fpm_confs() {
      local current="php$version-fpm.conf"
      for conf in /etc/apache2/conf-enabled/php*-fpm.conf; do
        [[ -e $conf ]] || continue
        local base
        base=$(basename "$conf")
        if [[ "$base" != "$current" ]]; then
          a2disconf "${base%.conf}" 2>/dev/null || true
          apache_needs_restart=true
        fi
      done
    }

    enable_required_modules() {
      local mods=(proxy proxy_fcgi setenvif rewrite ssl socache_shmcb headers) m
      for m in "${mods[@]}"; do
        if ! apache2ctl -M 2>/dev/null | grep -qi "${m}_module"; then
          a2enmod "$m"
          apache_needs_restart=true
        fi
      done
    }
    # ──────────────────────────────────

    if systemctl is-active --quiet "php$version-fpm"; then
      echo -e "${YELLOW}Configuring Apache to use PHP-FPM for PHP $version...${NC}"
      log_action "INFO" "Using PHP-FPM (php$version-fpm)."

      disable_other_mod_php
      disable_other_php_fpm_confs
      enable_required_modules

      a2enconf "php$version-fpm" 2>/dev/null || true
      a2dismod mpm_prefork 2>/dev/null || true
      a2enmod mpm_event 2>/dev/null || true
      apache_needs_restart=true

    else
      echo -e "${YELLOW}Configuring Apache to use mod_php for PHP $version...${NC}"
      log_action "INFO" "Using mod_php (libapache2-mod-php$version)."

      disable_other_php_fpm_confs
      disable_other_mod_php

      a2enmod "php$version" 2>/dev/null || {
        echo -e "${RED}mod_php for PHP $version not found. Install libapache2-mod-php$version?${NC}"
        log_action "ERROR" "Failed to enable mod_php for PHP $version."
        return 1
      }
      enable_required_modules

      a2dismod mpm_event 2>/dev/null || true
      a2enmod mpm_prefork 2>/dev/null || true
      apache_needs_restart=true
    fi

    if [[ "$apache_needs_restart" == true ]]; then
      echo -e "${YELLOW}Restarting Apache to apply changes...${NC}"
      log_action "INFO" "Restarting Apache."
      systemctl restart apache2
    fi
    ;;
  nginx | lighttpd)
    echo -e "${YELLOW}Configuring $selected_server to use PHP-FPM for PHP $version...${NC}"
    log_action "INFO" "Using PHP-FPM (php$version-fpm) for $selected_server."

    if ! systemctl is-active --quiet "php$version-fpm"; then
      echo -e "${RED}php$version-fpm is not running. Start it first.${NC}"
      log_action "ERROR" "php$version-fpm inactive."
      return 1
    fi

    echo -e "${YELLOW}Set your $selected_server fastcgi socket to:/run/php/php$version-fpm.sock${NC}"
    if [[ "$selected_server" == "nginx" ]]; then
      echo "  fastcgi_pass unix:/run/php/php$version-fpm.sock;"
    else
      echo "  fastcgi.server = ( \".php\" => (( \"socket\" => \"/run/php/php$version-fpm.sock\" )) )"
    fi
    ;;
  esac

  echo -e "${GREEN}Done configuring $selected_server with PHP $version.${NC}"
  log_action "INFO" "Completed configuration for $selected_server + PHP $version."
}

################################################################################
# Switch PHP Version (now supports --no-web and env/flag-based assume-yes)
################################################################################
switch_php_version() {
  require_sudo

  local requested_version=""
  local no_web_config=0
  local assume_yes=0

  if [[ -n "${PHPX_ASSUME_YES:-}" ]]; then
    assume_yes=1
  fi

  local -a enable_exts=()
  local -a disable_exts=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
    --no-web)
      no_web_config=1
      ;;
    -y | --yes)
      assume_yes=1
      ;;
    *)
      if [[ -z "$requested_version" ]]; then
        requested_version="$1"
      else
        if [[ "$1" == +* ]]; then
          enable_exts+=("${1:1}")
        elif [[ "$1" == -* ]]; then
          disable_exts+=("${1:1}")
        else
          enable_exts+=("$1")
        fi
      fi
      ;;
    esac
    shift
  done

  if [[ -z "$requested_version" ]]; then
    echo -e "${RED}No PHP version specified. Usage: phpx switch <X.Y> [--no-web]${NC}"
    log_action "ERROR" "No PHP version specified to switch."
    exit 1
  fi

  local final_version
  final_version="$(get_php_version "$requested_version" 2>/dev/null)"
  if [[ $? -ne 0 ]]; then
    echo -e "${YELLOW}Attempting to install PHP $requested_version...${NC}"
    log_action "INFO" "Attempting to install PHP $requested_version."
    install_php_version "$requested_version" || {
      echo -e "${RED}Failed to install PHP $requested_version. Aborting switch.${NC}"
      log_action "ERROR" "Failed to install PHP $requested_version in switch."
      exit 1
    }
    final_version="$(get_php_version "$requested_version")" || exit 1
  fi

  check_and_clean_php_extensions "$final_version"

  local php_bin="/usr/bin/php${final_version}"
  local phar_bin="/usr/bin/phar${final_version}"
  local pharphar_bin="/usr/bin/phar.phar${final_version}"

  if [[ ! -x "$php_bin" && -x "/usr/local/bin/php${final_version}" ]]; then
    php_bin="/usr/local/bin/php${final_version}"
    phar_bin="/usr/local/bin/phar${final_version}"
    pharphar_bin="/usr/local/bin/phar.phar${final_version}"
  fi

  if [[ -x "$php_bin" ]]; then
    update-alternatives --set php "$php_bin" >/dev/null 2>&1 || true
  fi
  if [[ -x "$phar_bin" ]]; then
    update-alternatives --set phar "$phar_bin" >/dev/null 2>&1 || true
  fi
  if [[ -x "$pharphar_bin" ]]; then
    update-alternatives --set phar.phar "$pharphar_bin" >/dev/null 2>&1 || true
  fi

  echo -e "${GREEN}Switched the default PHP CLI to version $final_version.${NC}"
  log_action "INFO" "Switched to PHP version $final_version."

  # Apply extension enable/disable requested via: phpx switch X.Y +ext -ext ext
  if [[ ${#enable_exts[@]} -gt 0 || ${#disable_exts[@]} -gt 0 ]]; then
    if command -v phpenmod >/dev/null 2>&1 && command -v phpdismod >/dev/null 2>&1; then
      local e pkg
      for e in "${enable_exts[@]}"; do
        [[ -n "$e" ]] || continue
        pkg="php${final_version}-${e}"
        if command -v dpkg >/dev/null 2>&1 && ! dpkg -l 2>/dev/null | awk '/^ii/ {print $2}' | grep -qx "$pkg"; then
          echo -e "${YELLOW}Installing extension package: $pkg${NC}"
          log_action "INFO" "Installing extension package in switch: $pkg"
          apt_update_once
          apt install -y "$pkg" 2>&1 | show_last_lines || {
            echo -e "${RED}Failed to install $pkg (skipping enable).${NC}"
            log_action "ERROR" "Failed to install extension package: $pkg"
            continue
          }
        fi
        phpenmod -v "$final_version" "$e" >/dev/null 2>&1 || true
      done

      for e in "${disable_exts[@]}"; do
        [[ -n "$e" ]] || continue
        phpdismod -v "$final_version" "$e" >/dev/null 2>&1 || true
      done

      local fpm_service="php${final_version}-fpm"
      if command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet "$fpm_service" 2>/dev/null; then
        systemctl reload "$fpm_service" >/dev/null 2>&1 || systemctl restart "$fpm_service" >/dev/null 2>&1 || true
      fi
    else
      echo -e "${YELLOW}phpenmod/phpdismod not found; skipping extension toggles.${NC}"
      log_action "WARN" "phpenmod/phpdismod not available; cannot toggle extensions in switch."
    fi
  fi

  if ((no_web_config == 0)); then
    configure_web_server "$final_version"
  else
    log_action "INFO" "Skipping web server configuration for PHP $final_version (--no-web)."
  fi
}

################################################################################
# Install PHP Extensions (interactive + non-interactive via --install and -y/env)
################################################################################
install_php_extensions() {
  require_root_for "install PHP extensions" || return 1
  [[ "$(detect_package_manager)" == apt ]] || { echo -e "${RED}Versioned PHP extension packages currently require the APT backend.${NC}" >&2; return 3; }

  local version=""
  local requested_install_list=""
  local assume_yes=0

  if [[ -n "${PHPX_ASSUME_YES:-}" ]]; then
    assume_yes=1
  fi

  # Parse args: [version] [--install=list] [-y|--yes]
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --install=*)
      requested_install_list="${1#*=}"
      ;;
    --install)
      shift
      requested_install_list="$1"
      ;;
    -y | --yes)
      assume_yes=1
      ;;
    *)
      if [[ -z "$version" ]]; then
        version="$1"
      else
        echo -e "${YELLOW}Unknown argument to ext: $1${NC}"
      fi
      ;;
    esac
    shift
  done

  # Detect PHP version if none provided
  if [[ -z "$version" ]]; then
    version="$(php -r 'echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;' 2>/dev/null)"
    if [[ -z "$version" ]]; then
      echo -e "${RED}No PHP version provided and unable to detect an active PHP version.${NC}"
      log_action "ERROR" "No PHP version provided and no active PHP version detected in install_php_extensions."
      exit 1
    fi
    echo -e "${YELLOW}No PHP version provided. Using detected PHP version: $version${NC}"
    log_action "INFO" "Detected PHP version: $version in install_php_extensions."
  fi

  # Ensure PHP version is installed
  if ! dpkg -l | grep -q "^ii  php$version "; then
    echo -e "${YELLOW}PHP $version is not installed. Attempting to install...${NC}"
    log_action "WARN" "PHP $version is not installed. Attempting to install."
    install_php_version "$version" || {
      echo -e "${RED}Failed to install PHP $version. Cannot install extensions.${NC}"
      log_action "ERROR" "Failed to install PHP $version in install_php_extensions."
      exit 1
    }
  fi

  # Clean any stale extension toggles
  check_and_clean_php_extensions "$version"

  # ─────────── Gather installed extensions ───────────
  log_action "INFO" "Listing installed PHP extensions for PHP $version."
  local installed_extensions=()
  IFS=$'\n' read -r -d '' -a installed_extensions < <(
    dpkg -l |
      grep "^ii" |
      grep "php$version-" |
      awk '{print $2}' |
      sed "s/^php$version-//" |
      sort &&
      printf '\0'
  )

  if [[ ${#installed_extensions[@]} -eq 0 ]]; then
    echo -e "${RED}No PHP extensions are installed for PHP $version.${NC}"
    log_action "WARN" "No PHP extensions found for PHP $version."
  else
    echo -e "${GREEN}Installed PHP extensions for PHP $version:${NC}"
    for i in "${!installed_extensions[@]}"; do
      printf "%2d. %-20s" $((i + 1)) "${installed_extensions[$i]}"
      (((i + 1) % 5 == 0)) && echo
    done
    echo
  fi

  # ─────────── Gather installable extensions ───────────
  log_action "INFO" "Listing installable PHP extensions for PHP $version."
  local available_extensions=()
  IFS=$'\n' read -r -d '' -a available_extensions < <(
    apt-cache pkgnames |
      grep "^php$version-" |
      sed "s/^php$version-//" |
      sort &&
      printf '\0'
  )

  if [[ ${#available_extensions[@]} -eq 0 ]]; then
    echo -e "${RED}No extensions found in apt-cache for PHP $version.${NC}"
    log_action "WARN" "No installable extensions found for PHP $version."
    return
  fi

  # Filter out already installed
  local filtered_extensions=()
  for ext in "${available_extensions[@]}"; do
    if [[ ! " ${installed_extensions[*]} " =~ " ${ext} " ]]; then
      filtered_extensions+=("$ext")
    fi
  done
  available_extensions=("${filtered_extensions[@]}")

  if [[ ${#available_extensions[@]} -eq 0 ]]; then
    echo -e "${GREEN}All available extensions for PHP $version are already installed.${NC}"
    log_action "INFO" "No new extensions to install for PHP $version."
    return
  fi

  # ─────────── Display installable extensions ───────────
  echo -e "${YELLOW}Installable PHP extensions for PHP $version:${NC}"
  for i in "${!available_extensions[@]}"; do
    printf "%2d. %-20s" $((i + 1)) "${available_extensions[$i]}"
    (((i + 1) % 5 == 0)) && echo
  done
  echo

  # ─────────── Collect selection ───────────
  local extensions_to_install=()

  if [[ -n "$requested_install_list" ]]; then
    # Non-interactive mode using names only
    IFS=',' read -r -a selection_array <<<"$requested_install_list"
    for sel in "${selection_array[@]}"; do
      sel="${sel//[[:space:]]/}"
      [[ -z "$sel" ]] && continue
      local found=0
      for ext in "${available_extensions[@]}"; do
        if [[ "$ext" == "$sel" ]]; then
          extensions_to_install+=("php$version-$ext")
          found=1
          break
        fi
      done
      if ((found == 0)); then
        echo -e "${YELLOW}Extension '$sel' not found in apt-cache for PHP $version. Skipping.${NC}"
        log_action "WARN" "Extension '$sel' not found for PHP $version in non-interactive ext."
      fi
    done
  else
    # Interactive selection (numbers or names)
    read -rp "Enter numbers or names of the extensions to install (comma-separated): " extension_selection
    IFS=',' read -r -a selection_array <<<"$extension_selection"

    for sel in "${selection_array[@]}"; do
      sel="${sel//[[:space:]]/}"
      if [[ "$sel" =~ ^[0-9]+$ ]]; then
        idx=$((sel - 1))
        [[ $idx -ge 0 && $idx -lt ${#available_extensions[@]} ]] &&
          extensions_to_install+=("php$version-${available_extensions[$idx]}")
      else
        for ext in "${available_extensions[@]}"; do
          [[ "$ext" == "$sel" ]] && extensions_to_install+=("php$version-$ext") && break
        done
      fi
    done
  fi

  if [[ ${#extensions_to_install[@]} -eq 0 ]]; then
    echo -e "${YELLOW}No valid extensions selected for installation.${NC}"
    log_action "INFO" "No valid extensions selected by user."
    return
  fi

  # ─────────── Install selected extensions ───────────
  echo -e "${YELLOW}Updating apt and installing:${NC} ${extensions_to_install[*]}"
  log_action "INFO" "Installing extensions: ${extensions_to_install[*]} for PHP $version."
  if ! package_install "${extensions_to_install[@]}" 2>&1 | show_last_lines; then
    echo -e "${RED}Failed to install one or more selected extensions.${NC}"
    log_action "ERROR" "Failed to install: ${extensions_to_install[*]} for PHP $version."
    return 1
  fi

  # ─────────── Enable newly installed extensions ───────────
  echo -e "${YELLOW}Enabling PHP extensions...${NC}"
  local pkg
  for pkg in "${extensions_to_install[@]}"; do
    local ext_name="${pkg#php$version-}"
    echo -e " • Enabling ${ext_name}..."
    phpenmod -v "$version" "$ext_name"
  done

  # ─────────── Reload FPM to pick up new modules ───────────
  if systemctl is-active --quiet "php$version-fpm"; then
    echo -e "${YELLOW}Reloading php$version-fpm service...${NC}"
    systemctl reload "php$version-fpm"
  fi

  echo -e "${GREEN}Successfully installed and enabled:${NC} ${extensions_to_install[*]}"
  log_action "INFO" "Installed & enabled extensions for PHP $version: ${extensions_to_install[*]}."
}

################################################################################
# Install Composer
################################################################################
install_composer() {
  require_root_for "install Composer" || return 1
  local do_update=0
  while (($#)); do
    case "$1" in
    --update) do_update=1 ;;
    --no-update) do_update=0 ;;
    *) echo -e "${RED}Unknown Composer option: $1${NC}" >&2; return 2 ;;
    esac
    shift
  done

  command -v php >/dev/null 2>&1 || { echo -e "${RED}PHP is required to install Composer.${NC}" >&2; return 1; }
  if ! command -v curl >/dev/null 2>&1; then
    package_install curl >/dev/null || { echo -e "${RED}curl is required to install Composer.${NC}" >&2; return 1; }
  fi

  if command -v composer >/dev/null 2>&1; then
    echo -e "${GREEN}Composer is already installed: $(composer --version 2>/dev/null | head -n1)${NC}"
    if ((do_update)); then
      composer self-update --stable --no-interaction || return 1
    else
      echo "Use 'phpx install composer --update' to explicitly update the installed Composer binary."
    fi
    return 0
  fi

  local tmp_dir installer signature
  tmp_dir="$(mktemp -d)" || return 1
  trap 'rm -rf -- "$tmp_dir"' RETURN
  installer="$tmp_dir/composer-setup.php"
  bounded_curl 'https://getcomposer.org/installer' --output "$installer" || return 1
  signature="$(bounded_curl 'https://composer.github.io/installer.sig')" || return 1
  verify_sha384 "$installer" "$signature" || {
    echo -e "${RED}Composer installer SHA-384 verification failed.${NC}" >&2
    return 1
  }

  php "$installer" --quiet --install-dir="$tmp_dir" --filename=composer || return 1
  php "$tmp_dir/composer" --version >/dev/null 2>&1 || return 1
  install -m 0755 -- "$tmp_dir/composer" /usr/local/bin/composer || return 1
  echo -e "${GREEN}Composer installed with verified upstream installer.${NC}"
  log_action INFO 'Composer installed after SHA-384 installer verification.'
}

################################################################################
# Install PECL Packages
################################################################################
install_pecl_package() {
  require_root_for "install PECL extensions" || return 1
  (($#)) || { echo -e "${RED}No PECL packages specified.${NC}" >&2; return 2; }
  [[ "$(detect_package_manager)" == apt ]] || {
    echo -e "${RED}Automatic PECL build dependency installation currently requires the APT backend.${NC}" >&2
    return 3
  }

  local package_list=() token p failures=0
  for token in "$@"; do
    IFS=',' read -r -a parts <<<"$token"
    for p in "${parts[@]}"; do
      p="${p//[[:space:]]/}"
      [[ -z "$p" ]] && continue
      validate_extension_name "$p" || { echo -e "${RED}Invalid PECL package name: $p${NC}" >&2; return 2; }
      package_list+=("$p")
    done
  done

  command -v pecl >/dev/null 2>&1 || package_install php-pear php-dev 2>&1 | show_last_lines || return 1
  command -v pecl >/dev/null 2>&1 || { echo -e "${RED}PECL is unavailable after dependency installation.${NC}" >&2; return 1; }

  for p in "${package_list[@]}"; do
    if pecl list 2>/dev/null | awk 'NR>3 {print $1}' | grep -Fxq "$p"; then
      echo -e "${GREEN}$p is already installed.${NC}"
      continue
    fi
    printf '
' | pecl install "$p" || { failures=$((failures + 1)); continue; }
    echo -e "${GREEN}$p installed successfully.${NC}"
  done
  ((failures == 0))
}

################################################################################
# Serve (PHP Built-In Server)
################################################################################
serve() {
  local host="127.0.0.1"
  local port="8000"
  local root_dir
  local verbose=false
  local router_file=""
  root_dir=$(pwd)

  while [[ "$1" ]]; do
    case "$1" in
    --host=*)
      host="${1#*=}"
      ;;
    --host)
      shift
      host="$1"
      ;;
    --port=*)
      port="${1#*=}"
      ;;
    --port)
      shift
      port="$1"
      ;;
    --root=*)
      root_dir="${1#*=}"
      ;;
    --root)
      shift
      root_dir="$1"
      ;;
    --router=*)
      router_file="${1#*=}"
      ;;
    --router)
      shift
      router_file="$1"
      ;;
    --verbose | -v)
      verbose=true
      ;;
    *)
      echo -e "${YELLOW}Unknown argument: $1${NC}"
      ;;
    esac
    shift
  done

  # 1. Check if `php` is available
  if ! command -v php &>/dev/null; then
    echo -e "${RED}No default PHP interpreter found on the system. Please install or switch to a valid PHP version.${NC}"
    log_action "ERROR" "No default PHP interpreter found for serve()."
    return 1
  fi

  # 2. Validate the root directory
  if [[ ! -d "$root_dir" ]]; then
    echo -e "${RED}The root directory $root_dir does not exist.${NC}"
    log_action "ERROR" "Root directory $root_dir does not exist."
    return 1
  fi

  # 3. Check if the port is available
  local port_in_use=false
  if command -v lsof &>/dev/null; then
    if lsof -i:"$port" &>/dev/null; then
      port_in_use=true
    fi
  else
    if command -v ss &>/dev/null; then
      if ss -lnt | grep -q ":$port "; then
        port_in_use=true
      fi
    elif command -v netstat &>/dev/null; then
      if netstat -lnt | grep -q ":$port "; then
        port_in_use=true
      fi
    else
      log_action "WARN" "No tool available to check if port $port is already in use."
    fi
  fi

  if [[ "$port_in_use" == true ]]; then
    echo -e "${RED}Port $port is already in use. Please specify a different port with --port.${NC}"
    log_action "ERROR" "Port $port is already in use."
    return 1
  fi

  # 4. Find a likely index file if user didn't provide a router
  local found_root_dir="$root_dir"
  if [[ -z "$router_file" ]]; then
    local index_files=(
      "$root_dir/public/index.php"
      "$root_dir/public/index.html"
      "$root_dir/index.php"
      "$root_dir/index.html"
    )
    for candidate in "${index_files[@]}"; do
      if [[ -f "$candidate" ]]; then
        found_root_dir="$(dirname "$candidate")"
        break
      fi
    done

    if [[ "$found_root_dir" != "$root_dir" ]]; then
      echo -e "${YELLOW}Using discovered index file in: $found_root_dir${NC}"
      log_action "INFO" "Found index in $found_root_dir, adjusting root."
    else
      echo -e "${YELLOW}No index.php or index.html found. Serving the provided root dir: $root_dir${NC}"
      log_action "INFO" "No index found. Serving $root_dir directly."
    fi
  else
    # If a custom router is specified, ensure it exists
    if [[ ! -f "$router_file" ]]; then
      echo -e "${RED}The router file $router_file does not exist.${NC}"
      log_action "ERROR" "Router file $router_file not found."
      return 1
    fi
    echo -e "${YELLOW}Using custom router file: $router_file${NC}"
    log_action "INFO" "Serving with custom router: $router_file."
  fi

  if [[ "$verbose" == true ]]; then
    echo -e "${YELLOW}Verbose mode: starting PHP server with details:${NC}"
    echo -e "${YELLOW}Host: $host  Port: $port  Root: $found_root_dir  Router: $router_file${NC}"
  fi

  log_action "INFO" "Starting PHP built-in server on $host:$port from $found_root_dir. Router=$router_file"
  if [[ -n "$router_file" ]]; then
    php -S "$host:$port" -t "$found_root_dir" "$router_file"
  else
    php -S "$host:$port" -t "$found_root_dir"
  fi
}

################################################################################
# Run a PHP Script with a Specified Version
################################################################################
run_php_script() {
  local script_path="$1"
  local version="$2"

  if [[ -z "$script_path" ]]; then
    echo -e "${RED}Error: No script path was provided.${NC}"
    log_action "ERROR" "No script path provided to run_php_script."
    exit 1
  fi
  if [[ ! -f "$script_path" ]]; then
    echo -e "${RED}Error: Script file not found at $script_path.${NC}"
    log_action "ERROR" "Script file not found at $script_path."
    exit 1
  fi

  if [[ -z "$version" ]]; then
    version="$(php -r 'echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;' 2>/dev/null)"
    if [[ -z "$version" ]]; then
      echo -e "${RED}No PHP version provided and unable to detect an active PHP version.${NC}"
      log_action "ERROR" "No version provided and no active PHP version found in run_php_script."
      exit 1
    fi
    echo -e "${YELLOW}No PHP version provided. Using detected PHP version: $version.${NC}"
    log_action "INFO" "Detected PHP version: $version for run_php_script."
  fi

  if ! command -v "/usr/bin/php$version" &>/dev/null && ! command -v "/usr/local/bin/php$version" &>/dev/null; then
    echo -e "${YELLOW}PHP version $version is not installed. Attempting to install...${NC}"
    log_action "WARN" "PHP $version not installed, attempting to install for run_php_script."
    install_php_version "$version" || {
      echo -e "${RED}Failed to install PHP $version. Cannot run the script.${NC}"
      log_action "ERROR" "Failed to install PHP $version for run_php_script."
      exit 1
    }
  fi

  local php_bin=""
  if command -v "/usr/bin/php$version" &>/dev/null; then
    php_bin="/usr/bin/php$version"
  else
    php_bin="/usr/local/bin/php$version"
  fi

  echo -e "${YELLOW}Running script $script_path with PHP $version...${NC}"
  log_action "INFO" "Running script $script_path with PHP $version."

  if ! "$php_bin" "$script_path"; then
    echo -e "${RED}The script $script_path encountered an error or exited with a non-zero status.${NC}"
    log_action "ERROR" "Script $script_path failed under PHP $version."
    exit 1
  else
    log_action "INFO" "Script $script_path completed successfully under PHP $version."
  fi
}

################################################################################
# List Installed PHP Versions
################################################################################
list_php_versions() {
  local -a versions=()
  local candidate version

  shopt -s nullglob
  for candidate in /usr/bin/php[0-9]*.[0-9]* /usr/local/bin/php[0-9]*.[0-9]*; do
    [[ -x "$candidate" ]] || continue
    version="${candidate##*/php}"
    [[ "$version" =~ ^[0-9]+\.[0-9]+$ ]] && versions+=("$version")
  done
  shopt -u nullglob

  if command -v php >/dev/null 2>&1; then
    version="$(php -r 'echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;' 2>/dev/null || true)"
    [[ "$version" =~ ^[0-9]+\.[0-9]+$ ]] && versions+=("$version")
  fi

  if ((${#versions[@]} == 0)); then
    echo -e "${YELLOW}No PHP CLI installations were discovered.${NC}"
    return 0
  fi

  mapfile -t versions < <(printf '%s\n' "${versions[@]}" | sort -Vu)
  local default_path default_version=""
  default_path="$(command -v php 2>/dev/null || true)"
  [[ -n "$default_path" ]] && default_version="$(php -r 'echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;' 2>/dev/null || true)"

  echo -e "${GREEN}Discovered PHP versions:${NC}"
  for version in "${versions[@]}"; do
    candidate="$(find_php_binary "$version" 2>/dev/null || true)"
    printf ' • PHP %-4s' "$version"
    [[ -n "$candidate" ]] && printf '  (CLI: %s)' "$candidate"
    [[ "$version" == "$default_version" ]] && printf '  [default CLI]'
    if service_exists "php${version}-fpm"; then
      if service_is_active "php${version}-fpm"; then
        printf '  [FPM: active]'
      else
        printf '  [FPM: installed/inactive]'
      fi
    fi
    printf '\n'
  done

  echo
  echo "Package backend: $(detect_package_manager)"
  echo "Service manager: $(detect_service_manager)"
  [[ -n "$default_path" ]] && echo -e "${YELLOW}Current default php:${NC} $default_path ${default_version:+(PHP $default_version)}"
}


################################################################################
# PHP Info (per version, summarized)
################################################################################
phpx_info() {
  local version="$1"

  # Resolve version
  if [[ -z "$version" ]]; then
    if command -v php &>/dev/null; then
      version="$(php -r 'echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;' 2>/dev/null)"
    fi
  fi

  if [[ -z "$version" ]]; then
    echo -e "${RED}Unable to determine PHP version. Usage: phpx info <X.Y>${NC}"
    log_action "ERROR" "info: no version detected or provided."
    return 1
  fi

  version="$(get_php_version "$version")" || return 1

  # Resolve binary
  local php_bin=""
  if [[ -x "/usr/bin/php$version" ]]; then
    php_bin="/usr/bin/php$version"
  elif [[ -x "/usr/local/bin/php$version" ]]; then
    php_bin="/usr/local/bin/php$version"
  else
    echo -e "${RED}Could not locate a php binary for version $version.${NC}"
    log_action "ERROR" "info: php binary for $version not found."
    return 1
  fi

  # php -i / php -m snapshot
  local php_info
  php_info="$("$php_bin" -i 2>/dev/null)"

  if [[ -z "$php_info" ]]; then
    echo -e "${RED}Failed to retrieve phpinfo() output for $php_bin.${NC}"
    log_action "ERROR" "info: php -i failed for $php_bin."
    return 1
  fi

  local module_list
  module_list="$("$php_bin" -m 2>/dev/null)"
  local extension_total
  extension_total="$(echo "$module_list" | grep -vE '^\s*$' | wc -l)"

  # helper to read php -i entries
  local get_val
  get_val() {
    local key="$1"
    echo "$php_info" | awk -F'=> ' -v key="$key" '
      index($1, key) == 1 {
        gsub(/^ +| +$/, "", $2);
        print $2;
        exit
      }
    '
  }

  # General config
  local loaded_ini additional_ini_dir ini_search_path extension_dir
  loaded_ini="$(get_val "Loaded Configuration File")"
  additional_ini_dir="$(get_val "Scan this dir for additional .ini files")"
  ini_search_path="$(get_val "Configuration File (php.ini) Path")"
  extension_dir="$(get_val "extension_dir")"

  # Key runtime settings (prioritized)
  local memory_limit max_execution_time max_input_time post_max_size upload_max_filesize default_socket_timeout
  local display_errors log_errors error_log
  memory_limit="$(get_val "memory_limit")"
  max_execution_time="$(get_val "max_execution_time")"
  max_input_time="$(get_val "max_input_time")"
  post_max_size="$(get_val "post_max_size")"
  upload_max_filesize="$(get_val "upload_max_filesize")"
  default_socket_timeout="$(get_val "default_socket_timeout")"
  display_errors="$(get_val "display_errors")"
  log_errors="$(get_val "log_errors")"
  error_log="$(get_val "error_log")"

  # FPM service state
  local fpm_state="not installed"
  if command -v systemctl &>/dev/null; then
    if systemctl is-active --quiet "php${version}-fpm"; then
      fpm_state="active"
    elif systemctl list-unit-files 2>/dev/null | grep -q "php${version}-fpm.service"; then
      fpm_state="installed (inactive)"
    fi
  fi

  # FPM pool details (best-effort)
  local fpm_pool_dir="/etc/php/${version}/fpm/pool.d"
  local fpm_listen fpm_pm fpm_max_children fpm_start_servers fpm_min_spare fpm_max_spare fpm_max_requests
  local fpm_slowlog fpm_req_slow_timeout

  if [[ -d "$fpm_pool_dir" ]]; then
    fpm_listen="$(
      grep -R "^[[:space:]]*listen[[:space:]]*=" "$fpm_pool_dir" 2>/dev/null |
        grep -vE '^\s*;' | head -n1 |
        awk -F'=' '{gsub(/^ +| +$/, "", $2); print $2}'
    )"
    fpm_pm="$(
      grep -R "^[[:space:]]*pm[[:space:]]*=" "$fpm_pool_dir" 2>/dev/null |
        grep -vE '^\s*;' | head -n1 |
        awk -F'=' '{gsub(/^ +| +$/, "", $2); print $2}'
    )"
    fpm_max_children="$(
      grep -R "^[[:space:]]*pm.max_children[[:space:]]*=" "$fpm_pool_dir" 2>/dev/null |
        grep -vE '^\s*;' | head -n1 |
        awk -F'=' '{gsub(/^ +| +$/, "", $2); print $2}'
    )"
    fpm_start_servers="$(
      grep -R "^[[:space:]]*pm.start_servers[[:space:]]*=" "$fpm_pool_dir" 2>/dev/null |
        grep -vE '^\s*;' | head -n1 |
        awk -F'=' '{gsub(/^ +| +$/, "", $2); print $2}'
    )"
    fpm_min_spare="$(
      grep -R "^[[:space:]]*pm.min_spare_servers[[:space:]]*=" "$fpm_pool_dir" 2>/dev/null |
        grep -vE '^\s*;' | head -n1 |
        awk -F'=' '{gsub(/^ +| +$/, "", $2); print $2}'
    )"
    fpm_max_spare="$(
      grep -R "^[[:space:]]*pm.max_spare_servers[[:space:]]*=" "$fpm_pool_dir" 2>/dev/null |
        grep -vE '^\s*;' | head -n1 |
        awk -F'=' '{gsub(/^ +| +$/, "", $2); print $2}'
    )"
    fpm_max_requests="$(
      grep -R "^[[:space:]]*pm.max_requests[[:space:]]*=" "$fpm_pool_dir" 2>/dev/null |
        grep -vE '^\s*;' | head -n1 |
        awk -F'=' '{gsub(/^ +| +$/, "", $2); print $2}'
    )"
    fpm_slowlog="$(
      grep -R "^[[:space:]]*slowlog[[:space:]]*=" "$fpm_pool_dir" 2>/dev/null |
        grep -vE '^\s*;' | head -n1 |
        awk -F'=' '{gsub(/^ +| +$/, "", $2); print $2}'
    )"
    fpm_req_slow_timeout="$(
      grep -R "^[[:space:]]*request_slowlog_timeout[[:space:]]*=" "$fpm_pool_dir" 2>/dev/null |
        grep -vE '^\s*;' | head -n1 |
        awk -F'=' '{gsub(/^ +| +$/, "", $2); print $2}'
    )"
  fi

  # OPcache + JIT values for printing + hints
  local opcache_enable opcache_enable_cli opcache_memory_consumption opcache_validate_timestamps opcache_revalidate_freq
  local opcache_max_accelerated_files opcache_jit opcache_jit_buffer_size
  opcache_enable="$(get_val "opcache.enable")"
  opcache_enable_cli="$(get_val "opcache.enable_cli")"
  opcache_memory_consumption="$(get_val "opcache.memory_consumption")"
  opcache_validate_timestamps="$(get_val "opcache.validate_timestamps")"
  opcache_revalidate_freq="$(get_val "opcache.revalidate_freq")"
  opcache_max_accelerated_files="$(get_val "opcache.max_accelerated_files")"
  opcache_jit="$(get_val "opcache.jit")"
  opcache_jit_buffer_size="$(get_val "opcache.jit_buffer_size")"

  local opcache_keys=(
    "opcache.enable"
    "opcache.enable_cli"
    "opcache.memory_consumption"
    "opcache.interned_strings_buffer"
    "opcache.max_accelerated_files"
    "opcache.validate_timestamps"
    "opcache.revalidate_freq"
    "opcache.fast_shutdown"
    "opcache.save_comments"
  )
  local jit_keys=(
    "opcache.jit"
    "opcache.jit_buffer_size"
    "opcache.jit_debug"
    "opcache.jit_prof_threshold"
  )

  # Extensions from dpkg (phpX.Y-* packages)
  local installed_ext_pkgs=()
  if command -v dpkg &>/dev/null; then
    IFS=$'\n' read -r -d '' -a installed_ext_pkgs < <(
      dpkg -l 2>/dev/null |
        grep "^ii" |
        grep "php${version}-" |
        awk '{print $2}' |
        sed "s/^php${version}-//" |
        sort &&
        printf '\0'
    )
  fi

  # Signal extensions
  local has_xdebug="no"
  if echo "$module_list" | grep -qi '^xdebug$'; then
    has_xdebug="yes"
  fi

  # Heuristic "mode" guess
  local mode_guess="unknown"
  if [[ "$display_errors" =~ [Oo]n ]] || [[ "$opcache_validate_timestamps" == "1" ]]; then
    mode_guess="development-ish"
  elif [[ "$opcache_enable" == "1" ]] && [[ "$opcache_validate_timestamps" == "0" ]]; then
    mode_guess="production-ish"
  fi

  # ────────────────────────────────────────────────────────────────
  # Output
  # ────────────────────────────────────────────────────────────────
  echo -e "${GREEN}PHP Info for $version${NC}"
  echo "---------------------------------"
  echo "Binary:          $php_bin"
  echo "Mode (guess):    $mode_guess"
  echo "Loaded php.ini:  ${loaded_ini:-<not reported>}"
  echo "Additional ini:  ${additional_ini_dir:-<none>}"
  echo "INI search path: ${ini_search_path:-<unknown>}"
  echo "extension_dir:   ${extension_dir:-<unknown>}"
  echo

  echo "Key settings:"
  echo "  memory_limit           = ${memory_limit:-<unknown>}"
  echo "  max_execution_time     = ${max_execution_time:-<unknown>}"
  echo "  max_input_time         = ${max_input_time:-<unknown>}"
  echo "  post_max_size          = ${post_max_size:-<unknown>}"
  echo "  upload_max_filesize    = ${upload_max_filesize:-<unknown>}"
  echo "  default_socket_timeout = ${default_socket_timeout:-<unknown>}"
  echo "  display_errors         = ${display_errors:-<unknown>}"
  echo "  log_errors             = ${log_errors:-<unknown>}"
  echo "  error_log              = ${error_log:-<unknown>}"
  echo

  echo "FPM:"
  echo "  Service: php${version}-fpm -> ${fpm_state}"
  echo "  Pool dir: $fpm_pool_dir"
  [[ -n "$fpm_listen" ]]           && echo "  listen               = $fpm_listen"
  [[ -n "$fpm_pm" ]]               && echo "  pm                   = $fpm_pm"
  [[ -n "$fpm_max_children" ]]     && echo "  pm.max_children      = $fpm_max_children"
  [[ -n "$fpm_start_servers" ]]    && echo "  pm.start_servers     = $fpm_start_servers"
  [[ -n "$fpm_min_spare" ]]        && echo "  pm.min_spare_servers = $fpm_min_spare"
  [[ -n "$fpm_max_spare" ]]        && echo "  pm.max_spare_servers = $fpm_max_spare"
  [[ -n "$fpm_max_requests" ]]     && echo "  pm.max_requests      = $fpm_max_requests"
  [[ -n "$fpm_slowlog" ]]          && echo "  slowlog              = $fpm_slowlog"
  [[ -n "$fpm_req_slow_timeout" ]] && echo "  request_slowlog_timeout = $fpm_req_slow_timeout"
  echo

  echo "Extensions:"
  echo "  Total modules (php -m): ${extension_total:-0}"
  echo "  xdebug loaded:          $has_xdebug"
  if [[ ${#installed_ext_pkgs[@]} -gt 0 ]]; then
    echo "  apt php${version}-* packages:"
    local i
    for i in "${!installed_ext_pkgs[@]}"; do
      printf "    %-18s" "${installed_ext_pkgs[$i]}"
      (((i + 1) % 4 == 0)) && echo
    done
    echo
  else
    echo "  apt php${version}-* packages: <none detected>"
  fi
  echo

  echo "OPcache:"
  local key val
  for key in "${opcache_keys[@]}"; do
    val="$(get_val "$key")"
    [[ -n "$val" ]] && printf "  %-25s = %s\n" "$key" "$val"
  done
  echo

  echo "JIT:"
  for key in "${jit_keys[@]}"; do
    val="$(get_val "$key")"
    [[ -n "$val" ]] && printf "  %-25s = %s\n" "$key" "$val"
  done
  echo

  # Simple perf hints (best-effort)
  echo "Perf hints:"
  if [[ "$opcache_enable" != "1" ]]; then
    echo "  - OPcache is disabled; enable it for anything non-trivial."
  fi
  if [[ "$memory_limit" =~ ^([0-9]+)(M|G)$ ]]; then
    local num="${BASH_REMATCH[1]}"; local unit="${BASH_REMATCH[2]}"
    # treat <256M as low
    if [[ "$unit" == "M" && "$num" -lt 256 ]]; then
      echo "  - memory_limit < 256M; may be tight for modern frameworks."
    fi
  fi
  if [[ "$has_xdebug" == "yes" ]] && [[ "$mode_guess" != "development-ish" ]]; then
    echo "  - xdebug is loaded; consider disabling in production (big perf hit)."
  fi
  if [[ "$opcache_validate_timestamps" == "1" ]] && [[ "$opcache_revalidate_freq" == "0" || "$opcache_revalidate_freq" == "1" ]]; then
    echo "  - OPcache is re-validating very frequently; OK for dev, sub-optimal for prod."
  fi
  if [[ -n "$opcache_memory_consumption" ]]; then
    # strip non-digits
    local mem_raw="${opcache_memory_consumption//[^0-9]/}"
    if [[ -n "$mem_raw" && "$mem_raw" -lt 128 ]]; then
      echo "  - opcache.memory_consumption < 128; consider bumping for large apps."
    fi
  fi
  if [[ "$opcache_jit_buffer_size" == "0" || "$opcache_jit" == "0" ]]; then
    echo "  - JIT effectively disabled; that's fine, but know it's off."
  fi

  log_action "INFO" "info: displayed extended summary + hints for PHP $version ($php_bin)."
}

################################################################################
# Doctor (sanity checker)
################################################################################
doctor_php_version() {
  local version=""
  local do_fix=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
    --fix)
      do_fix=1
      ;;
    *)
      if [[ -z "$version" ]]; then
        version="$1"
      fi
      ;;
    esac
    shift
  done

  if [[ -z "$version" ]]; then
    if command -v php &>/dev/null; then
      version="$(php -r 'echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;' 2>/dev/null)"
    fi
  fi

  if [[ -z "$version" ]]; then
    echo -e "${RED}Unable to determine which PHP version to inspect. Usage: phpx doctor <X.Y> [--fix]${NC}"
    log_action "ERROR" "doctor: no version detected or provided."
    return 1
  fi

  version="$(get_php_version "$version")" || return 1

  local php_bin=""
  if [[ -x "/usr/bin/php$version" ]]; then
    php_bin="/usr/bin/php$version"
  elif [[ -x "/usr/local/bin/php$version" ]]; then
    php_bin="/usr/local/bin/php$version"
  else
    echo -e "${RED}Could not find php binary for $version.${NC}"
    log_action "ERROR" "doctor: php binary for $version not found."
    return 1
  fi

  echo -e "${GREEN}phpx doctor for PHP $version${NC}"
  echo "---------------------------------"

  # Snapshot php -i / php -m (for internal analysis only)
  local php_info module_list
  php_info="$("$php_bin" -i 2>/dev/null || true)"
  module_list="$("$php_bin" -m 2>/dev/null || true)"

  # Small helper to read php -i values (no printing)
  local get_val
  get_val() {
    local key="$1"
    echo "$php_info" | awk -F'=> ' -v key="$key" '
      index($1, key) == 1 {
        gsub(/^ +| +$/, "", $2);
        print $2;
        exit
      }
    '
  }

  # Helper to convert sizes like 128M / 1G → bytes (best-effort)
  local to_bytes
  to_bytes() {
    local v="$1"
    [[ -z "$v" || "$v" == "-1" ]] && { echo 0; return; }
    # Strip spaces
    v="${v//[[:space:]]/}"
    # Just a plain number?
    if [[ "$v" =~ ^[0-9]+$ ]]; then
      echo "$v"
      return
    fi
    local num unit
    num="${v%[kKmMgG]}"
    unit="${v:${#v}-1:1}"
    if ! [[ "$num" =~ ^[0-9]+$ ]]; then
      echo 0
      return
    fi
    case "$unit" in
    k|K) echo $((num * 1024)) ;;
    m|M) echo $((num * 1024 * 1024)) ;;
    g|G) echo $((num * 1024 * 1024 * 1024)) ;;
    *)   echo 0 ;;
    esac
  }

  # ────────────────────────────────────────────────────────────────
  # 1) CLI vs FPM / default CLI
  # ────────────────────────────────────────────────────────────────
  local default_cli_version=""
  if command -v php &>/dev/null; then
    default_cli_version="$(php -r 'echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;' 2>/dev/null || echo "")"
  fi

  if [[ -n "$default_cli_version" ]]; then
    if [[ "$default_cli_version" == "$version" ]]; then
      echo "[OK]  Default CLI PHP version is $default_cli_version (matches inspected version)."
    else
      echo "[WARN] Default CLI PHP version is $default_cli_version; you are inspecting $version."
      echo "       - To switch CLI: phpx switch $version"
      echo "       - Or inspect CLI version instead: phpx doctor $default_cli_version"
    fi
  else
    echo "[WARN] Could not determine default CLI PHP (php command not found)."
  fi

  # FPM service status
  if command -v systemctl &>/dev/null; then
    if systemctl is-active --quiet "php${version}-fpm"; then
      echo "[OK]  php${version}-fpm service is active."
    elif systemctl list-unit-files 2>/dev/null | grep -q "php${version}-fpm.service"; then
      echo "[WARN] php${version}-fpm service is installed but not running."
    else
      echo "[INFO] php${version}-fpm service is not installed (CLI-only setup)."
    fi
  else
    echo "[INFO] systemctl not available; skipping FPM service checks."
  fi

  # ────────────────────────────────────────────────────────────────
  # 2) Broken extensions (.so) via php -m stderr
  # ────────────────────────────────────────────────────────────────
  local php_modules_output
  php_modules_output="$("$php_bin" -m 2>&1 || true)"

  local missing_exts=()
  IFS=$'\n' read -r -d '' -a missing_exts < <(
    echo "$php_modules_output" |
      grep "Unable to load dynamic library" |
      awk -F"'" '{print $2}' &&
      printf '\0'
  )

  if [[ ${#missing_exts[@]} -eq 0 ]]; then
    echo "[OK]  No broken extension .so references reported by PHP $version."
  else
    echo "[WARN] Broken extension entries detected for PHP $version:"
    for ext in "${missing_exts[@]}"; do
      echo "       - $ext"
    done
    echo "       Suggested: phpx clean $version"
    if ((do_fix == 1)); then
      echo "       Applying cleanup now (phpx clean $version)..."
      check_and_clean_php_extensions "$version"
    else
      echo "       Or: phpx doctor $version --fix  (to auto-remove ini refs)"
    fi
  fi

  # ────────────────────────────────────────────────────────────────
  # 3) Apache PHP module conflicts (mod_php)
  # ────────────────────────────────────────────────────────────────
  if command -v apache2ctl &>/dev/null; then
    local apache_php_mods
    apache_php_mods="$(apache2ctl -M 2>/dev/null |
      grep -Eo 'php[0-9]+\.[0-9]+_module' |
      sed 's/_module//' | sort -u)"

    if [[ -z "$apache_php_mods" ]]; then
      echo "[OK]  No mod_php modules reported by Apache (likely using PHP-FPM or no PHP)."
    else
      local count_mods
      count_mods="$(echo "$apache_php_mods" | wc -l | awk '{print $1}')"
      if ((count_mods == 1)); then
        echo "[OK]  Apache has a single PHP module enabled: $apache_php_mods"
      else
        echo "[WARN] Multiple Apache PHP modules are enabled:"
        echo "$apache_php_mods" | sed 's/^/       - /'
        if ((do_fix == 1)); then
          require_sudo
          local target_mod="php$version"
          if ! echo "$apache_php_mods" | grep -q "^$target_mod$"; then
            target_mod="$(echo "$apache_php_mods" | head -n1)"
          fi
          echo "       Disabling all but $target_mod ..."
          while read -r mod; do
            [[ -z "$mod" ]] && continue
            if [[ "$mod" != "$target_mod" ]]; then
              a2dismod "$mod" 2>/dev/null || true
            fi
          done <<<"$apache_php_mods"
          echo "       Run: systemctl restart apache2  (to apply changes)."
        else
          echo "       Consider keeping only one, e.g. for PHP $version:"
          echo "         sudo a2dismod phpX.Y (others...)"
        fi
      fi
    fi
  else
    echo "[INFO] Apache not detected (apache2ctl missing); skipping mod_php checks."
  fi

  # ────────────────────────────────────────────────────────────────
  # 4) FPM max_children vs memory hint
  # ────────────────────────────────────────────────────────────────
  local total_mem_mb
  total_mem_mb="$(free -m 2>/dev/null | awk '/^Mem:/{print $2}')"
  if [[ -n "$total_mem_mb" && "$total_mem_mb" =~ ^[0-9]+$ ]]; then
    local avg_per_child=40
    local rec_children=$((total_mem_mb / avg_per_child))
    if ((rec_children < 5)); then rec_children=5; fi
    if ((rec_children > 512)); then rec_children=512; fi

    local fpm_pool_dir="/etc/php/$version/fpm/pool.d"
    local current_children=""
    if [[ -d "$fpm_pool_dir" ]]; then
      current_children="$(
        grep -R "pm.max_children" "$fpm_pool_dir" 2>/dev/null |
          grep -vE '^\s*;' |
          awk -F'=' 'NR==1{gsub(/ /,"",$2); print $2}'
      )"
    fi

    if [[ -n "$current_children" ]]; then
      echo "[INFO] php-fpm pm.max_children ≈ $current_children (current), recommended ballpark for ${total_mem_mb}MB RAM ≈ $rec_children."
    else
      echo "[INFO] Unable to detect pm.max_children for PHP-FPM $version; approx recommended for ${total_mem_mb}MB RAM: $rec_children."
    fi
  else
    echo "[INFO] Could not determine total system memory; skipping FPM sizing hints."
  fi

  # ────────────────────────────────────────────────────────────────
  # 5) Key runtime settings: only warn when obviously off
  # ────────────────────────────────────────────────────────────────
  if [[ -n "$php_info" ]]; then
    local memory_limit max_execution_time max_input_time post_max_size upload_max_filesize display_errors log_errors
    memory_limit="$(get_val "memory_limit")"
    max_execution_time="$(get_val "max_execution_time")"
    max_input_time="$(get_val "max_input_time")"
    post_max_size="$(get_val "post_max_size")"
    upload_max_filesize="$(get_val "upload_max_filesize")"
    display_errors="$(get_val "display_errors")"
    log_errors="$(get_val "log_errors")"

    # memory_limit < 256M
    local mem_bytes
    mem_bytes="$(to_bytes "$memory_limit")"
    if ((mem_bytes > 0 && mem_bytes < 268435456)); then # 256M
      echo "[WARN] memory_limit (${memory_limit:-?}) is under 256M; can be tight for modern frameworks."
    fi

    # max_execution_time too high (or unlimited)
    if [[ -n "$max_execution_time" && "$max_execution_time" != "0" && "$max_execution_time" -gt 300 ]]; then
      echo "[WARN] max_execution_time = $max_execution_time; consider lowering (<300s) for runaway script protection."
    fi

    # post_max_size / upload_max_filesize mismatch
    local post_bytes up_bytes
    post_bytes="$(to_bytes "$post_max_size")"
    up_bytes="$(to_bytes "$upload_max_filesize")"
    if ((post_bytes > 0 && up_bytes > 0 && up_bytes > post_bytes)); then
      echo "[WARN] upload_max_filesize ($upload_max_filesize) > post_max_size ($post_max_size); large uploads will be rejected."
    fi

    # dev-style error display
    if [[ "$display_errors" =~ [Oo]n ]] && [[ "$log_errors" =~ [Oo]f[fF]? ]]; then
      echo "[WARN] display_errors is On while log_errors is Off; for production, prefer logging over on-page errors."
    fi
  fi

  # ────────────────────────────────────────────────────────────────
  # 6) OPcache & JIT: status + obvious issues only
  # ────────────────────────────────────────────────────────────────
  if [[ -n "$php_info" ]]; then
    local opcache_enable opcache_memory_consumption opcache_validate_timestamps opcache_revalidate_freq
    local opcache_jit opcache_jit_buffer_size
    opcache_enable="$(get_val "opcache.enable")"
    opcache_memory_consumption="$(get_val "opcache.memory_consumption")"
    opcache_validate_timestamps="$(get_val "opcache.validate_timestamps")"
    opcache_revalidate_freq="$(get_val "opcache.revalidate_freq")"
    opcache_jit="$(get_val "opcache.jit")"
    opcache_jit_buffer_size="$(get_val "opcache.jit_buffer_size")"

    if [[ "$opcache_enable" != "1" ]]; then
      echo "[WARN] OPcache appears disabled; enable it for any non-trivial application."
    fi

    local op_mem_raw
    op_mem_raw="$(to_bytes "${opcache_memory_consumption}M")" # if it's just a number like '128'
    if ((op_mem_raw > 0 && op_mem_raw < 134217728)); then # <128M
      echo "[WARN] opcache.memory_consumption (${opcache_memory_consumption:-?}) may be low for larger codebases."
    fi

    if [[ "$opcache_validate_timestamps" == "1" && ( "$opcache_revalidate_freq" == "0" || "$opcache_revalidate_freq" == "1" ) ]]; then
      echo "[INFO] OPcache is revalidating on every request (freq=$opcache_revalidate_freq); ideal for dev, not for production."
    fi

    if [[ -z "$opcache_jit_buffer_size" || "$opcache_jit_buffer_size" == "0" || "$opcache_jit" == "0" ]]; then
      echo "[INFO] JIT appears disabled (buffer/jit=0); acceptable, just be aware it's off."
    fi
  fi

  # ────────────────────────────────────────────────────────────────
  # 7) xdebug presence
  # ────────────────────────────────────────────────────────────────
  if echo "$module_list" | grep -qi '^xdebug$'; then
    echo "[WARN] xdebug extension is loaded. Great for debugging, but a major slowdown in production."
  fi

  echo
  echo -e "${GREEN}phpx doctor completed for PHP $version.${NC}"
  log_action "INFO" "doctor: completed for PHP $version (fix=$do_fix)."
}

################################################################################
# phpbrew-like native features (no phpbrew dependency)
################################################################################

# List versions known to apt sources (Sury/system repos)
phpx_known() {
  local show_more=0
  if [[ "${1:-}" == "--more" ]]; then
    show_more=1
    shift || true
  fi

  if ! command -v apt-cache >/dev/null 2>&1; then
    echo -e "${YELLOW}apt-cache not found; showing installed versions only.${NC}"
    list_php_versions
    return 0
  fi

  local versions=()
  IFS=$'\n' read -r -d '' -a versions < <(
    apt-cache pkgnames 2>/dev/null |
      grep -E '^php[0-9]+\.[0-9]+-cli$' |
      sed -E 's/^php([0-9]+\.[0-9]+)-cli$/\1/' |
      sort -Vu &&
      printf '\0'
  )

  if [[ ${#versions[@]} -eq 0 ]]; then
    echo -e "${YELLOW}No PHP versions found in APT cache. (Did you run 'phpx sury'?)${NC}"
    return 0
  fi

  echo -e "${GREEN}Known PHP versions from APT:${NC}"
  local v
  for v in "${versions[@]}"; do
    if ((show_more == 1)) && command -v apt-cache >/dev/null 2>&1; then
      # Try to show candidate package version (best-effort)
      local cand=""
      cand="$(apt-cache policy "php${v}-cli" 2>/dev/null | awk -F': ' '/Candidate:/ {print $2; exit}' || true)"
      if [[ -n "$cand" && "$cand" != "(none)" ]]; then
        printf "  - %s (candidate: %s)\n" "$v" "$cand"
      else
        printf "  - %s\n" "$v"
      fi
    else
      printf "  - %s\n" "$v"
    fi
  done
}

# Variant map: these are distro-oriented "feature presets" (install/enable packages)
# Notes:
# - Some phpbrew compile-time variants have no true equivalent in apt builds (e.g. -debug),
#   so we implement a pragmatic runtime analogue (e.g. disable xdebug).
phpx_variants() {
  # Show:
  #  1) Local installed PHP versions (X.Y)
  #  2) Remote-available PHP versions from APT that are NOT installed locally
  # Optional: --more prints candidate package versions.

  local show_more=0
  if [[ "${1:-}" == "--more" ]]; then
    show_more=1
  fi

  if ! command -v apt-cache >/dev/null 2>&1; then
    echo -e "${YELLOW}APT not found. 'variants' currently supports Debian/Ubuntu package metadata only.${NC}"
    return 0
  fi

  # ---- local installed versions (prefer dpkg phpX.Y-cli) ----
  local local_versions=()
  if command -v dpkg >/dev/null 2>&1; then
    IFS=$'
' read -r -d '' -a local_versions < <(
      dpkg -l 2>/dev/null \
        | awk '/^ii/ {print $2}' \
        | grep -E '^php[0-9]+\.[0-9]+-cli$' \
        | sed -E 's/^php//;s/-cli$//' \
        | sort -Vu && printf '\0'
    )
  fi

  # Fallback: detect /usr/bin/phpX.Y
  if [[ ${#local_versions[@]} -eq 0 ]]; then
    IFS=$'
' read -r -d '' -a local_versions < <(
      ls -1 /usr/bin/php[0-9].[0-9] 2>/dev/null \
        | sed -E 's#.*/php##' \
        | sort -Vu && printf '\0'
    )
  fi

  echo -e "${GREEN}Local installed PHP versions:${NC}"
  if [[ ${#local_versions[@]} -eq 0 ]]; then
    echo "  (none detected)"
  else
    local v
    for v in "${local_versions[@]}"; do
      echo "  - $v"
    done
  fi

  # Build a set for local versions
  declare -A _local_set=()
  local v
  for v in "${local_versions[@]}"; do
    [[ -n "$v" ]] && _local_set["$v"]=1
  done

  # ---- remote available versions (apt metadata) ----
  local remote_versions=()
  IFS=$'
' read -r -d '' -a remote_versions < <(
    apt-cache pkgnames 2>/dev/null \
      | grep -E '^php[0-9]+\.[0-9]+-cli$' \
      | sed -E 's/^php//;s/-cli$//' \
      | sort -Vu && printf '\0'
  )

  # Filter remote versions not installed locally
  local not_installed=()
  for v in "${remote_versions[@]}"; do
    [[ -n "$v" ]] || continue
    if [[ -z "${_local_set[$v]:-}" ]]; then
      not_installed+=("$v")
    fi
  done

  echo
  echo -e "${GREEN}Remote-available PHP versions (not installed locally):${NC}"
  if [[ ${#not_installed[@]} -eq 0 ]]; then
    echo "  (none detected)"
    return 0
  fi

  for v in "${not_installed[@]}"; do
    if ((show_more == 1)); then
      local cand=""
      cand="$(apt-cache policy "php${v}-cli" 2>/dev/null | awk -F': ' '/Candidate:/ {print $2; exit}' || true)"
      if [[ -n "$cand" && "$cand" != "(none)" ]]; then
        printf "  - %s (candidate: %s)
" "$v" "$cand"
      else
        printf "  - %s
" "$v"
      fi
    else
      printf "  - %s
" "$v"
    fi
  done
}

phpx__variant_to_ext_pkg() {
  # Map variant token -> apt extension suffix (without phpX.Y- prefix).
  # Return empty if the variant is not an apt extension package.
  local v="$1"
  case "$v" in
  default) echo "__DEFAULT__" ;;
  dbs) echo "__DBS__" ;;
  mysql) echo "mysql" ;;
  pgsql) echo "pgsql" ;;
  sqlite) echo "sqlite3" ;;
  curl) echo "curl" ;;
  mbstring) echo "mbstring" ;;
  xml) echo "xml" ;;
  zip) echo "zip" ;;
  gd) echo "gd" ;;
  intl) echo "intl" ;;
  soap) echo "soap" ;;
  opcache) echo "opcache" ;;
  redis) echo "redis" ;;
  memcached) echo "memcached" ;;
  imagick) echo "imagick" ;;
  imap) echo "imap" ;;
  xdebug) echo "xdebug" ;;
  *) echo "" ;;
  esac
}

phpx__apt_has_package() {
  local pkg="$1"
  apt-cache show "$pkg" >/dev/null 2>&1
}

phpx_build() {
  require_sudo

  if [[ $# -lt 1 ]]; then
    echo -e "${RED}Usage: phpx build <X.Y> [+variant|-variant ...] [-- <configure flags>]${NC}"
    return 2
  fi

  local version="$1"
  shift
  validate_php_version "$version"

  # Parse variants until `--` (config flags are accepted but ignored on apt builds)
  local raw_variants=()
  local ignored_flags=()
  while [[ $# -gt 0 ]]; do
    if [[ "$1" == "--" ]]; then
      shift
      ignored_flags=("$@")
      break
    fi
    raw_variants+=("$1")
    shift
  done

  if [[ ${#ignored_flags[@]} -gt 0 ]]; then
    echo -e "${YELLOW}Note:${NC} configure flags are not applicable to apt-based builds; ignoring: ${ignored_flags[*]}"
    log_action "WARN" "build: ignored configure flags: ${ignored_flags[*]}"
  fi

  # Always ensure core packages.
  install_php_version "$version" || return 1

  local want_fpm=0
  local want_apache=0

  # Expand variants to package suffixes and toggles
  local install_suffixes=()
  local disable_suffixes=()

  local token op name mapped
  for token in "${raw_variants[@]}"; do
    op="${token:0:1}"
    name="$token"
    if [[ "$op" == "+" || "$op" == "-" ]]; then
      name="${token:1}"
    else
      op="+"
    fi

    # Service toggles
    case "$name" in
    fpm) [[ "$op" == "+" ]] && want_fpm=1 || want_fpm=0; continue ;;
    apache2) [[ "$op" == "+" ]] && want_apache=1 || want_apache=0; continue ;;
    debug) # closest meaning on packaged builds
      name="xdebug"
      ;;
    esac

    mapped="$(phpx__variant_to_ext_pkg "$name")"
    if [[ -z "$mapped" ]]; then
      echo -e "${YELLOW}Unknown variant:${NC} $token (use 'phpx variants --more')"
      continue
    fi

    if [[ "$mapped" == "__DEFAULT__" ]]; then
      # Common baseline
      local defaults=(curl mbstring xml zip intl gd opcache soap mysql pgsql sqlite3)
      if [[ "$op" == "+" ]]; then
        install_suffixes+=("${defaults[@]}")
      else
        disable_suffixes+=("${defaults[@]}")
      fi
      continue
    fi

    if [[ "$mapped" == "__DBS__" ]]; then
      local dbs=(mysql pgsql sqlite3)
      if [[ "$op" == "+" ]]; then
        install_suffixes+=("${dbs[@]}")
      else
        disable_suffixes+=("${dbs[@]}")
      fi
      continue
    fi

    if [[ "$op" == "+" ]]; then
      install_suffixes+=("$mapped")
    else
      disable_suffixes+=("$mapped")
    fi
  done

  # Uniq the lists (lightweight)
  local uniq_install=()
  local seen=" "
  local s
  for s in "${install_suffixes[@]}"; do
    [[ "$seen" == *" $s "* ]] && continue
    uniq_install+=("$s")
    seen+=" $s "
  done
  install_suffixes=("${uniq_install[@]}")

  local uniq_disable=()
  seen=" "
  for s in "${disable_suffixes[@]}"; do
    [[ "$seen" == *" $s "* ]] && continue
    uniq_disable+=("$s")
    seen+=" $s "
  done
  disable_suffixes=("${uniq_disable[@]}")

  # Install required extension packages that exist
  local pkgs=()
  for s in "${install_suffixes[@]}"; do
    local pkg="php${version}-${s}"
    if phpx__apt_has_package "$pkg"; then
      pkgs+=("$pkg")
    else
      echo -e "${YELLOW}Skipping:${NC} $pkg not found in apt sources."
      log_action "WARN" "build: missing apt package: $pkg"
    fi
  done

  if [[ ${#pkgs[@]} -gt 0 ]]; then
    apt_update_once
    echo -e "${YELLOW}Installing variant packages:${NC} ${pkgs[*]}"
    if ! apt install -y "${pkgs[@]}" 2>&1 | show_last_lines; then
      echo -e "${RED}Failed to install one or more variant packages.${NC}"
      return 1
    fi

    # Enable installed modules
    for s in "${install_suffixes[@]}"; do
      if phpx__apt_has_package "php${version}-${s}"; then
        phpenmod -v "$version" "$s" >/dev/null 2>&1 || true
      fi
    done
  fi

  # Disable requested modules
  if [[ ${#disable_suffixes[@]} -gt 0 ]]; then
    for s in "${disable_suffixes[@]}"; do
      phpdismod -v "$version" "$s" >/dev/null 2>&1 || true
    done
  fi

  # FPM toggle
  if ((want_fpm == 1)); then
    if systemctl list-unit-files | grep -q "^php${version}-fpm\.service"; then
      systemctl enable "php${version}-fpm" >/dev/null 2>&1 || true
      systemctl restart "php${version}-fpm" >/dev/null 2>&1 || true
    fi
  fi

  # Apache toggle (best-effort package + enable is handled by `phpx apache ...`)
  if ((want_apache == 1)); then
    if dpkg -l | grep -q "^ii  apache2 "; then
      echo -e "${YELLOW}Apache detected.${NC} Use 'phpx apache fpm ${version}' or 'phpx apache modphp ${version}' to wire PHP."
    fi
  fi

  echo -e "${GREEN}Build preset applied for PHP ${version}.${NC}"
}

# Source/PECL/GitHub extension installer (native, no phpbrew)
phpx_ext_src() {
  require_root_for "phpx ext-src" || return 1
  [[ "$(detect_package_manager)" == apt ]] || { echo -e "${RED}phpx ext-src currently requires the APT backend.${NC}" >&2; return 3; }

  local action="${1:-}"; shift || true
  local version="" enable=1
  while (($#)); do
    case "$1" in
    --php=*) version="${1#*=}"; shift ;;
    --php) shift; version="${1:-}"; shift || true ;;
    --no-enable) enable=0; shift ;;
    *) break ;;
    esac
  done
  [[ -n "$version" ]] || version="$(php -r 'echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;' 2>/dev/null || true)"
  validate_php_version "$version"
  local ext="${1:-}"
  [[ -n "$ext" ]] || { echo -e "${RED}Usage: phpx ext-src <install|uninstall> <pecl-name|github:org/repo[@ref]> [--php X.Y] [--no-enable]${NC}" >&2; return 2; }
  [[ "$action" == install || "$action" == uninstall || "$action" == remove ]] || { echo -e "${RED}Unknown action: $action${NC}" >&2; return 2; }

  install_php_version "$version" || return 1
  package_install git build-essential autoconf pkg-config "php${version}-dev" php-pear 2>&1 | show_last_lines || return 1

  local phpbin phpconfig phpize ext_dir mods_avail name ini_file
  phpbin="$(find_php_binary "$version")" || return 1
  phpconfig="$(command -v "php-config${version}" 2>/dev/null || true)"
  phpize="$(command -v "phpize${version}" 2>/dev/null || true)"
  [[ -n "$phpconfig" && -n "$phpize" ]] || { echo -e "${RED}phpize/php-config for PHP $version are required.${NC}" >&2; return 1; }
  ext_dir="$($phpconfig --extension-dir 2>/dev/null)"
  mods_avail="/etc/php/${version}/mods-available"

  if [[ "$ext" == github:* ]]; then
    local spec="${ext#github:}" ref=""
    validate_github_extension_spec "$spec" || { echo -e "${RED}Invalid GitHub extension spec.${NC}" >&2; return 2; }
    if [[ "$spec" == *@* ]]; then ref="${spec##*@}"; spec="${spec%%@*}"; fi
    name="${spec##*/}"
  else
    validate_extension_name "$ext" || { echo -e "${RED}Invalid extension name: $ext${NC}" >&2; return 2; }
    name="${ext%%-*}"
  fi
  ini_file="${mods_avail}/${name}.ini"

  if [[ "$action" != install ]]; then
    phpdismod -v "$version" "$name" >/dev/null 2>&1 || true
    if [[ -f "$ini_file" ]] && grep -Fq '; generated by phpx ext-src' "$ini_file"; then rm -f -- "$ini_file"; fi
    echo -e "${GREEN}Disabled $name; only phpx-owned INI metadata was removed.${NC}"
    return 0
  fi

  local tmp_dir backup_so="" installed_so="${ext_dir}/${name}.so"
  tmp_dir="$(mktemp -d)" || return 1
  trap 'rm -rf -- "$tmp_dir"' RETURN
  if [[ -f "$installed_so" ]]; then backup_so="$tmp_dir/original.so"; cp -a -- "$installed_so" "$backup_so"; fi

  if [[ "$ext" == github:* ]]; then
    local clone_dir="$tmp_dir/src" repo_url="https://github.com/${spec}.git"
    if [[ -n "$ref" ]]; then
      git clone --depth 1 --branch "$ref" -- "$repo_url" "$clone_dir" 2>&1 | show_last_lines || return 1
    else
      git clone --depth 1 -- "$repo_url" "$clone_dir" 2>&1 | show_last_lines || return 1
    fi
    (cd "$clone_dir" && "$phpize" >/dev/null && ./configure --with-php-config="$phpconfig" >/dev/null && make -j"$(nproc 2>/dev/null || echo 2)" >/dev/null && make install >/dev/null) || {
      [[ -n "$backup_so" ]] && cp -a -- "$backup_so" "$installed_so"
      return 1
    }
  else
    printf '
' | "$phpbin" "$(command -v pecl)" install "$ext" 2>&1 | show_last_lines || return 1
    local matched
    matched="$(find "$ext_dir" -maxdepth 1 -type f -name "${name}*.so" -print -quit 2>/dev/null || true)"
    [[ -n "$matched" ]] && installed_so="$matched"
  fi

  if ((enable)); then
    mkdir -p -- "$mods_avail" || return 1
    if ! printf '; generated by phpx ext-src
extension=%s
' "$(basename -- "$installed_so")" | atomic_write_file "$ini_file" 0644; then
      [[ -n "$backup_so" ]] && cp -a -- "$backup_so" "${ext_dir}/${name}.so"
      return 1
    fi
    phpenmod -v "$version" "$name" >/dev/null 2>&1 || {
      rm -f -- "$ini_file"
      [[ -n "$backup_so" ]] && cp -a -- "$backup_so" "${ext_dir}/${name}.so"
      return 1
    }
    service_is_active "php${version}-fpm" && service_action reload "php${version}-fpm" >/dev/null 2>&1 || true
  fi
  echo -e "${GREEN}Installed extension $name for PHP $version.${NC}"
}

# FPM command suite
phpx_fpm() {
  local sub="${1:-status}"
  shift || true

  local version="${1:-}"
  if [[ -z "$version" ]]; then
    version="$(php -r 'echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;' 2>/dev/null || true)"
  else
    shift || true
  fi
  validate_php_version "$version"

  local svc="php${version}-fpm"
  case "$sub" in
  status)
    if ! service_exists "$svc"; then
      echo -e "${YELLOW}${svc}: not installed or not registered with the service manager${NC}"
      return 1
    fi
    if service_is_active "$svc"; then
      echo -e "${GREEN}${svc}: active${NC}"
    else
      echo -e "${YELLOW}${svc}: inactive${NC}"
    fi
    ;;
  config)
    echo -e "${GREEN}PHP-FPM config paths for ${version}:${NC}"
    echo "  main: /etc/php/${version}/fpm/php-fpm.conf"
    echo "  pools: /etc/php/${version}/fpm/pool.d/"
    echo "  php.ini: /etc/php/${version}/fpm/php.ini"
    ;;
  test)
    local bin="php-fpm${version}"
    if command -v "$bin" >/dev/null 2>&1; then
      "$bin" -t
    else
      echo -e "${YELLOW}php-fpm${version} binary is not available for a config test.${NC}"
      return 1
    fi
    ;;
  start | stop | restart | reload)
    require_root_for "phpx fpm $sub" || return 1
    service_exists "$svc" || { echo -e "${RED}Service not found: ${svc}${NC}"; return 1; }
    service_action "$sub" "$svc"
    ;;
  enable | disable)
    require_root_for "phpx fpm $sub" || return 1
    service_exists "$svc" || { echo -e "${RED}Service not found: ${svc}${NC}"; return 1; }
    service_enable_action "$sub" "$svc"
    ;;
  *)
    echo -e "${RED}Usage:${NC} phpx fpm {start|stop|restart|reload|status|enable|disable|test|config} [X.Y]"
    return 2
    ;;
  esac
}


# Apache command suite
phpx_apache() {
  local sub="${1:-status}"
  shift || true

  local version="${1:-}"
  if [[ -n "$version" ]]; then
    shift || true
  fi

  if ! command -v apache2ctl >/dev/null 2>&1 && ! command -v apachectl >/dev/null 2>&1; then
    echo -e "${RED}Apache control binary is not installed.${NC}"
    return 1
  fi

  case "$sub" in
  status)
    systemctl is-active --quiet apache2 && echo -e "${GREEN}apache2: active${NC}" || echo -e "${YELLOW}apache2: inactive${NC}"
    echo -e "${GREEN}Loaded PHP modules:${NC}"
    apache2ctl -M 2>/dev/null | grep -E 'php[0-9]+\.[0-9]+_module' || echo "  (none)"
    echo -e "${GREEN}Enabled PHP-FPM conf:${NC}"
    ls -1 /etc/apache2/conf-enabled 2>/dev/null | grep -E '^php[0-9]+\.[0-9]+-fpm\.conf$' || echo "  (none)"
    ;;
  reload|restart)
    require_root_for "phpx apache $sub" || return 1
    service_action "$sub" apache2
    ;;
  fpm)
    require_root_for "phpx apache fpm" || return 1
    if [[ -z "$version" ]]; then
      echo -e "${RED}Usage:${NC} phpx apache fpm <X.Y>"
      return 2
    fi
    validate_php_version "$version"
    install_php_version "$version" || return 1

    # Ensure required modules
    a2enmod proxy_fcgi setenvif >/dev/null 2>&1 || true

    # Disable any mod_php
    local mods
    mods=$(apache2ctl -M 2>/dev/null | grep -Eo 'php[0-9]+\.[0-9]+_module' | sed 's/_module//' || true)
    local m
    for m in $mods; do
      a2dismod "$m" >/dev/null 2>&1 || true
    done

    # Disable other php*-fpm confs and enable target
    local conf
    for conf in /etc/apache2/conf-available/php*-fpm.conf; do
      [[ -e "$conf" ]] || continue
      local base
      base="$(basename "$conf" .conf)"
      [[ "$base" != "php${version}-fpm" ]] && a2disconf "$base" >/dev/null 2>&1 || true
    done
    if [[ -f "/etc/apache2/conf-available/php${version}-fpm.conf" ]]; then
      a2enconf "php${version}-fpm" >/dev/null 2>&1 || true
    else
      echo -e "${YELLOW}Missing conf:${NC} /etc/apache2/conf-available/php${version}-fpm.conf"
      echo -e "${YELLOW}Tip:${NC} On some distros you must create an Apache proxy_fcgi vhost config manually."
    fi

    systemctl restart "php${version}-fpm" >/dev/null 2>&1 || true
    systemctl reload apache2
    echo -e "${GREEN}Apache is now configured to use PHP-FPM ${version}.${NC}"
    ;;
  modphp)
    require_root_for "phpx apache modphp" || return 1
    if [[ -z "$version" ]]; then
      echo -e "${RED}Usage:${NC} phpx apache modphp <X.Y>"
      return 2
    fi
    validate_php_version "$version"
    apt_update_once
    apt install -y "libapache2-mod-php${version}" 2>&1 | show_last_lines || return 1

    # Disable any php*-fpm confs
    local conf
    for conf in /etc/apache2/conf-available/php*-fpm.conf; do
      [[ -e "$conf" ]] || continue
      a2disconf "$(basename "$conf" .conf)" >/dev/null 2>&1 || true
    done
    a2dismod proxy_fcgi >/dev/null 2>&1 || true

    # Disable other mod_php and enable target
    local mods
    mods=$(apache2ctl -M 2>/dev/null | grep -Eo 'php[0-9]+\.[0-9]+_module' | sed 's/_module//' || true)
    local m
    for m in $mods; do
      [[ "$m" != "php${version}" ]] && a2dismod "$m" >/dev/null 2>&1 || true
    done
    a2enmod "php${version}" >/dev/null 2>&1 || true

    systemctl reload apache2
    echo -e "${GREEN}Apache is now configured to use mod_php ${version}.${NC}"
    ;;
  *)
    echo -e "${RED}Usage:${NC} phpx apache {status|reload|restart|fpm|modphp} [X.Y]"
    return 2
    ;;
  esac
}


################################################################################
# PHP Syntax Checker (lint)
################################################################################
phpx_syntax() {
  # Default excludes
  local -a excludes=("vendor" "node_modules")
  local jobs=""
  local phpbin="php"
  local want_progress=1

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --exclude=*)
        excludes+=("${1#*=}")
        ;;
      --exclude)
        shift
        [[ -n "${1:-}" ]] || { echo -e "${RED}Missing value for --exclude${NC}"; return 2; }
        excludes+=("$1")
        ;;
      --jobs=*)
        jobs="${1#*=}"
        ;;
      --jobs)
        shift
        [[ -n "${1:-}" ]] || { echo -e "${RED}Missing value for --jobs${NC}"; return 2; }
        jobs="$1"
        ;;
      --php=*)
        phpbin="${1#*=}"
        ;;
      --php)
        shift
        [[ -n "${1:-}" ]] || { echo -e "${RED}Missing value for --php${NC}"; return 2; }
        phpbin="$1"
        ;;
      --no-progress)
        want_progress=0
        ;;
      -h|--help)
        echo -e "${GREEN}Usage:${NC} phpx syntax [--exclude dir]... [--jobs N] [--php bin] [--progress] [extra_excludes...]"
        echo
        echo "Defaults:"
        echo "  - excludes: vendor, node_modules"
        echo "  - jobs:     nproc (or hw.ncpu)"
        echo "  - php:      php (from PATH)"
        echo
        echo "Behavior:"
        echo "  - prints ONLY failures (single line per file)"
        echo "  - progress is OFF by default; enable with --progress (TTY only)"
        echo "  - adds sequence numbering in output"
        return 0
        ;;
      *)
        # Allow passing directories as bare args to exclude
        excludes+=("$1")
        ;;
    esac
    shift
  done

  if ! command -v "$phpbin" >/dev/null 2>&1; then
    echo -e "${RED}PHP binary not found: $phpbin${NC}"
    return 2
  fi

  if [[ -z "$jobs" ]]; then
    jobs="$(nproc 2>/dev/null || true)"
    [[ -n "$jobs" ]] || jobs="$(sysctl -n hw.ncpu 2>/dev/null || true)"
    [[ -n "$jobs" ]] || jobs="1"
  fi
  [[ "$jobs" =~ ^[0-9]+$ ]] || jobs="1"
  (( jobs < 1 )) && jobs=1

  # Build find prune expression
  local -a prune=()
  local ex
  for ex in "${excludes[@]}"; do
    [[ -n "$ex" ]] || continue
    if [[ "$ex" == /* ]]; then
      prune+=( -path "$ex" -o -path "$ex/*" -o )
    else
      prune+=( -path "./$ex" -o -path "./$ex/*" -o )
    fi
  done
  if [[ ${#prune[@]} -gt 0 ]]; then
    unset 'prune[${#prune[@]}-1]'
  fi

  # Progress is OFF by default (to keep output clean). Enable with --progress (TTY only).
  local show_progress=0 cols=120
  if (( want_progress )) && [[ -t 2 ]]; then
    show_progress=1
    cols="$(tput cols 2>/dev/null || echo 120)"
    [[ "$cols" =~ ^[0-9]+$ ]] || cols=120
    (( cols < 40 )) && cols=120
  fi

  _phpx_progress() {
    (( show_progress )) || return 0
    local msg="$1"
    # \r = carriage return, \033[2K = clear whole line
    printf '\r\033[2K%-*.*s' "$cols" "$cols" "$msg" >&2
  }

  _phpx_clear_line() {
    (( show_progress )) || return 0
    printf '\r\033[2K' >&2
  }

  # Collect file list (null-safe)
  local -a files=()
  if [[ ${#prune[@]} -gt 0 ]]; then
    mapfile -d '' -t files < <(find -L . \( "${prune[@]}" \) -prune -o -name "*.php" -print0 2>/dev/null)
  else
    mapfile -d '' -t files < <(find -L . -name "*.php" -print0 2>/dev/null)
  fi

  local total=${#files[@]}
  if (( total == 0 )); then
    echo -e "${YELLOW}No PHP files found.${NC}"
    return 0
  fi

  # Store errors to temp dir keyed by scan index -> stable order + safe concurrency
  local tmpd
  tmpd="$(mktemp -d 2>/dev/null || mktemp -d -t phpx_syntax)"
  trap 'rm -rf "$tmpd" 2>/dev/null || true' RETURN

  _phpx_extract_first_error_line() {
    # stdin: php -l output
    # stdout: first meaningful error line (Parse/Fatal), fallback to first line
    awk '
      NR==1 { first=$0 }
      /^PHP (Parse|Fatal|Warning|Deprecated|Notice) error:/ { print; exit }
      /^PHP (Parse|Fatal) error:/ { print; exit }
      END { if (!printed && first!="") print first }
    '
  }

  _phpx_format_line() {
  # $1 = raw php -l first line
  local line="$1"

  # No colors when stdout isn't a TTY (keeps piping/logs clean)
  if [[ ! -t 1 ]]; then
    printf '%s' "$line"
    return 0
  fi

  # Best-effort parse:
  # PHP Parse error:  <msg> in <file> on line <n>
  # PHP Fatal error:  <msg> in <file> on line <n>
  # (also handles Warning/Deprecated/Notice formats similarly)
  local kind msg file lineno
  if [[ "$line" =~ ^(PHP[[:space:]]+(Parse|Fatal|Warning|Deprecated|Notice)[[:space:]]+error:)[[:space:]]*(.*)[[:space:]]+in[[:space:]]+(.+)[[:space:]]+on[[:space:]]+line[[:space:]]+([0-9]+)[[:space:]]*$ ]]; then
    kind="${BASH_REMATCH[1]}"
    msg="${BASH_REMATCH[3]}"
    file="${BASH_REMATCH[4]}"
    lineno="${BASH_REMATCH[5]}"
  else
    # fallback: just color the leading kind if present
    if [[ "$line" =~ ^(PHP[[:space:]]+(Parse|Fatal|Warning|Deprecated|Notice)[[:space:]]+error:)(.*)$ ]]; then
      kind="${BASH_REMATCH[1]}"
      msg="${BASH_REMATCH[3]}"
      msg="${msg# }"
    else
      printf '%s' "$line"
      return 0
    fi
  fi

  local kind_color="$RED"
  case "$kind" in
    *Warning*|*Deprecated*|*Notice*) kind_color="$YELLOW" ;;
  esac

  # Kind in red/yellow, message in normal, file in bold yellow, line number in cyan
  if [[ -n "${file:-}" && -n "${lineno:-}" ]]; then
    printf '%s%s%s %s in %s%s%s on line %s%s%s' \
      "$kind_color" "$kind" "$NC" \
      "$msg" \
      "$YELLOW" "$file" "$NC" \
      "$CYAN" "$lineno" "$NC"
  else
    printf '%s%s%s %s%s%s' "$kind_color" "$kind" "$NC" "$MAG" "$msg" "$NC"
  fi
}

  _phpx_lint_one() {
    # $1 = scan index (1..N), $2 = file path
    local idx="$1" f="$2" out first key
    out="$("$phpbin" -l "$f" 2>&1)"
    if grep -q "No syntax errors detected" <<<"$out"; then
      return 0
    fi
    first="$(printf '%s
' "$out" | _phpx_extract_first_error_line | head -n1)"
    printf -v key '%06d' "$idx"
    printf '%s
' "$first" > "${tmpd}/${key}.err"
    return 1
  }

  _phpx_wait_any() {
    if wait -n 2>/dev/null; then
      return $?
    fi
    # fallback for older bash
    local pid="${pids[0]:-}"
    [[ -n "$pid" ]] || return 0
    wait "$pid"
    return $?
  }

  local processed=0 running=0 failed=0
  local -a pids=()
  local f pid rc

  set +e
  for f in "${files[@]}"; do
    processed=$((processed + 1))
    _phpx_progress "Scanning ($processed/$total): $f"

    _phpx_lint_one "$processed" "$f" &
    pid=$!
    pids+=("$pid")
    running=$((running + 1))

    if (( running >= jobs )); then
      _phpx_wait_any
      rc=$?

      # prune finished pids
      local -a alive=()
      local p
      for p in "${pids[@]}"; do
        if kill -0 "$p" 2>/dev/null; then
          alive+=("$p")
        fi
      done
      pids=("${alive[@]}")
      running=${#pids[@]}
      (( rc != 0 )) && failed=1
    fi
  done

  for pid in "${pids[@]}"; do
    wait "$pid"
    rc=$?
    (( rc != 0 )) && failed=1
  done
  set -e

  _phpx_clear_line

  # Print errors in stable scan order with numbering
  local n=0 ef raw formatted
  shopt -s nullglob
  for ef in "${tmpd}"/*.err; do
    raw="$(cat "$ef" 2>/dev/null || true)"
    [[ -n "$raw" ]] || continue
    n=$((n + 1))
    if [[ -t 1 ]]; then
      printf "%s%d.%s " "$CYAN" "$n" "$NC"
      _phpx_format_line "$raw"
      printf "\n"
    else
      printf "%d. " "$n"
      _phpx_format_line "$raw"
      printf "\n"
    fi
  done
  shopt -u nullglob

  if (( failed == 0 )); then
    echo -e "${GREEN}Syntax OK (no failures).${NC}"
    return 0
  fi

  # Ensure we reset color before printing final status
  echo -e "${RED}Syntax check failed.${NC}" >&2
  return 1
}



